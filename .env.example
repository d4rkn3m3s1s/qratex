# Copy to .env (local) or set in Vercel Project → Settings → Environment Variables.
# Never commit real secrets.

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# NextAuth (required in production)
NEXTAUTH_URL="https://your-domain.example"
# Üretimde zorunlu, min 32 karakter (yoksa startup'ta hata). openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Oturum süresi (saniye). Varsayılan 86400 (24sa). Sızan token penceresini daraltmak için kısaltın.
# NEXTAUTH_SESSION_MAX_AGE=86400
# Parola bcrypt round sayısı (varsayılan 12, aralık 10-15). Donanım hızlandıkça artırın.
# BCRYPT_ROUNDS=12

# Public URL (canonical links, emails, OG — recommended in production)
NEXT_PUBLIC_APP_URL="https://your-domain.example"

# Email: Resend and/or SMTP (see lib/mail-sender.ts)
# RESEND_API_KEY=
# RESEND_FROM="QRATEX <onboarding@resend.dev>"
# EMAIL_FROM="QRATEX <noreply@your-domain.example>"
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FALLBACK_RESEND=true

# OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_ID=
# GITHUB_SECRET=

# OpenAI / AI features (optional, if used)
# OPENAI_API_KEY=

# Sentry build (optional; unset or 1 to use Sentry wrapper on build)
# DISABLE_SENTRY_BUILD=1
# SENTRY_ORG=
# SENTRY_PROJECT=

# Vercel sets automatically; no need locally unless testing
# VERCEL_URL=
