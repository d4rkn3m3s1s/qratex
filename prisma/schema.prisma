generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// AUTH MODELS
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DEALER
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          Role      @default(CUSTOMER)
  points        Int       @default(0)
  level         Int       @default(1)
  xp            Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  badges        UserBadge[]
  quests        UserQuest[]
  rewards       UserReward[]
  feedbacks     Feedback[]
  qrCodes       QRCode[]
  notifications Notification[]
  uploads       FileUpload[]
  analytics     AnalyticsEvent[]
  auditLogs     AuditLog[]
  donations     Donation[]

  // Dealer specific
  businessName  String?
  businessLogo  String?
  businessDesc  String?

  // Physical Card System Relations
  physicalCards        PhysicalCard[]      @relation("CustomerCards")
  customerConsumptions Consumption[]       @relation("CustomerConsumptions")
  dealerConsumptions   Consumption[]       @relation("DealerConsumptions")
  customerReviews      ConsumptionReview[] @relation("CustomerReviews")
  dealerCategories     ProductCategory[]   @relation("DealerCategories")
  dealerProducts       Product[]           @relation("DealerProducts")
  cardAuditLogs        CardAuditLog[]      @relation("CardAuditLogs")
  createdBatches       CardBatch[]         @relation("CreatedBatches")
  
  // New Feature Relations
  referralsMade        Referral[]            @relation("Referrals")
  referredBy           Referral?             @relation("ReferredBy")
  referralCode         ReferralCode?         @relation("UserReferralCode")
  streak               UserStreak?           @relation("UserStreak")
  vipStatus            UserVIPStatus?        @relation("UserVIP")
  birthday             UserBirthday?         @relation("UserBirthday")
  happyHours           HappyHour[]           @relation("DealerHappyHours")
  suspiciousActivities SuspiciousActivity[]  @relation("UserSuspiciousActivities")
  dealerAlerts         SuspiciousActivity[]  @relation("DealerSuspiciousActivities")
  pushSubscriptions    PushSubscription[]    @relation("PushSubscriptions")
  pushNotifications    PushNotificationLog[] @relation("PushNotificationLogs")
  offlineQueue         OfflineQueue[]        @relation("DealerOfflineQueue")
  favoriteProducts     DealerFavoriteProduct[] @relation("DealerFavorites")
  quickPresets         QuickScanPreset[]     @relation("DealerQuickPresets")
  customerCLV          CustomerLifetimeValue? @relation("CustomerCLV")
  heatmapData          HeatmapData[]         @relation("DealerHeatmap")

  @@index([email])
  @@index([role])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────
// GAMIFICATION MODELS
// ─────────────────────────────────────────────────────────────

model Badge {
  id          String      @id @default(cuid())
  name        String
  description String
  icon        String
  category    String      @default("general")
  rarity      String      @default("common") // common, rare, epic, legendary
  requirement Json        // { type: "feedback_count", value: 10 }
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users UserBadge[]

  @@index([category])
  @@index([isActive])
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model Quest {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  type        String   @default("daily") // daily, weekly, special
  requirement Json     // { type: "give_feedback", count: 3 }
  reward      Json     // { points: 100, xp: 50 }
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserQuest[]

  @@index([type])
  @@index([isActive])
}

model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  questId     String
  progress    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
  @@index([questId])
}

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  cost        Int      // Points required
  type        String   @default("digital") // digital, physical, coupon
  stock       Int      @default(-1) // -1 = unlimited
  metadata    Json?    // Additional reward data
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserReward[]

  @@index([type])
  @@index([isActive])
}

model UserReward {
  id          String    @id @default(cuid())
  userId      String
  rewardId    String
  redeemedAt  DateTime  @default(now())
  claimedAt   DateTime?
  code        String?   @unique // For coupon codes

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rewardId])
}

// ─────────────────────────────────────────────────────────────
// QR CODE & FEEDBACK MODELS
// ─────────────────────────────────────────────────────────────

model QRCode {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  dealerId    String
  isActive    Boolean  @default(true)
  scanCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  dealer    User       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  feedbacks Feedback[]

  @@index([code])
  @@index([dealerId])
  @@index([isActive])
}

model Feedback {
  id          String   @id @default(cuid())
  qrCodeId    String
  userId      String?  // Can be anonymous
  rating      Int      // 1-5
  text        String?  @db.Text
  media       Json?    // Array of media URLs
  sentiment   String?  // positive, negative, neutral
  emotions    Json?    // { happy: 0.8, sad: 0.1, ... }
  topics      Json?    // ["service", "quality", ...]
  isToxic     Boolean  @default(false)
  aiAnalysis  Json?    // Full AI response
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  qrCode QRCode @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([qrCodeId])
  @@index([userId])
  @@index([rating])
  @@index([sentiment])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// SYSTEM MODELS
// ─────────────────────────────────────────────────────────────

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([category])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  metadata    Json?
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@index([isEnabled])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String    @default("info") // info, success, warning, error
  isRead    Boolean   @default(false)
  data      Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model FileUpload {
  id        String   @id @default(cuid())
  userId    String
  filename  String
  mimetype  String
  size      Int
  url       String
  thumbnail String?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  category  String
  data      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event])
  @@index([category])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// CMS MODELS
// ─────────────────────────────────────────────────────────────

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     Json     // Block-based content
  meta        Json?    // SEO metadata
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model MenuItem {
  id        String   @id @default(cuid())
  location  String   // header, footer, sidebar
  label     String
  href      String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  parentId  String?
  roles     Json?    // ["ADMIN", "DEALER"] or null for all
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location])
  @@index([isActive])
  @@index([order])
}

model Theme {
  id          String   @id @default(cuid())
  name        String
  isActive    Boolean  @default(false)
  colors      Json     // Color palette
  fonts       Json?    // Font settings
  customCss   String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model PricingPlan {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float
  currency    String   @default("TRY")
  interval    String   @default("monthly") // monthly, yearly, lifetime
  features    Json     // Array of feature strings
  isPopular   Boolean  @default(false)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

model Coupon {
  id           String    @id @default(cuid())
  code         String    @unique
  type         String    @default("percentage") // percentage, fixed
  value        Float
  minPurchase  Float?
  maxUses      Int       @default(-1) // -1 = unlimited
  usedCount    Int       @default(0)
  expiresAt    DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────
// PHYSICAL CARD SYSTEM (QR Kartlı Tüketim Sistemi)
// ─────────────────────────────────────────────────────────────

enum CardStatus {
  UNUSED      // Henüz aktive edilmemiş
  ACTIVATED   // Müşteriye bağlanmış
  BLOCKED     // Bloklanmış
}

model PhysicalCard {
  id          String     @id @default(cuid())
  token       String     @unique // Benzersiz QR token (nanoid)
  batchId     String?    // Toplu üretim batch ID
  status      CardStatus @default(UNUSED)
  customerId  String?    // Aktive edildiğinde müşteri ID
  activatedAt DateTime?
  blockedAt   DateTime?
  blockReason String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  customer     User?           @relation("CustomerCards", fields: [customerId], references: [id], onDelete: SetNull)
  consumptions Consumption[]
  auditLogs    CardAuditLog[]

  @@index([token])
  @@index([status])
  @@index([customerId])
  @@index([batchId])
  @@index([createdAt])
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("🍽️")
  dealerId  String?  // null = global kategori
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealer   User?     @relation("DealerCategories", fields: [dealerId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([dealerId])
  @@index([isActive])
  @@index([order])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float?
  categoryId  String
  dealerId    String?  // null = global ürün
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category     ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dealer       User?           @relation("DealerProducts", fields: [dealerId], references: [id], onDelete: Cascade)
  consumptions Consumption[]
  favoritedBy  DealerFavoriteProduct[] @relation("FavoritedBy")
  quickPresets QuickScanPreset[]       @relation("QuickPresetProducts")

  @@index([categoryId])
  @@index([dealerId])
  @@index([isActive])
}

model Consumption {
  id         String   @id @default(cuid())
  cardId     String
  customerId String
  dealerId   String
  productId  String?
  amount     Float?   // Tutar (opsiyonel)
  note       String?  // Bayi notu
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  card     PhysicalCard        @relation(fields: [cardId], references: [id], onDelete: Cascade)
  customer User                @relation("CustomerConsumptions", fields: [customerId], references: [id], onDelete: Cascade)
  dealer   User                @relation("DealerConsumptions", fields: [dealerId], references: [id], onDelete: Cascade)
  product  Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  review   ConsumptionReview?

  @@index([cardId])
  @@index([customerId])
  @@index([dealerId])
  @@index([productId])
  @@index([createdAt])
}

model ConsumptionReview {
  id            String   @id @default(cuid())
  consumptionId String   @unique
  customerId    String
  rating        Int      // 1-5 genel puan
  text          String?  @db.Text
  dimensions    Json?    // { taste: 5, service: 4, ambiance: 5, value: 4 }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  consumption Consumption @relation(fields: [consumptionId], references: [id], onDelete: Cascade)
  customer    User        @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([consumptionId])
  @@index([customerId])
  @@index([rating])
  @@index([createdAt])
}

model CardAuditLog {
  id        String   @id @default(cuid())
  cardId    String
  userId    String?
  action    String   // CREATED, ACTIVATED, BLOCKED, UNBLOCKED, SCANNED, CONSUMPTION_ADDED
  metadata  Json?    // Ek bilgiler
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  card PhysicalCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User?        @relation("CardAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([cardId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model CardBatch {
  id          String   @id @default(cuid())
  name        String   // Batch adı (ör: "Ocak 2024 - 1000 Kart")
  quantity    Int      // Üretilen kart sayısı
  prefix      String?  // Token prefix (opsiyonel)
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation("CreatedBatches", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// SOCIAL RESPONSIBILITY / DONATION MODELS
// ─────────────────────────────────────────────────────────────

model DonationProject {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  icon        String   // Emoji or icon path
  category    String   // water, education, environment, animals, health
  goal        Int      // Target points
  current     Int      @default(0) // Current collected points
  impact      Json     // { unit: "litre", perPoint: 10, label: "Temiz Su" }
  tags        Json?    // ["Temel İhtiyaç", "Afrika"]
  isActive    Boolean  @default(true)
  isFeatured  Boolean  @default(false)
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  donations Donation[]

  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
}

model Donation {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  points    Int      // Points donated
  message   String?  // Optional message
  isPublic  Boolean  @default(true) // Show in leaderboard
  createdAt DateTime @default(now())
  
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project DonationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// REFERRAL SYSTEM
// ─────────────────────────────────────────────────────────────

model Referral {
  id             String    @id @default(cuid())
  referrerId     String    // User who referred
  referredId     String    @unique // User who was referred
  referralCode   String    // Code used
  status         String    @default("PENDING") // PENDING, COMPLETED, EXPIRED
  pointsEarned   Int       @default(0) // Points earned by referrer
  bonusGiven     Int       @default(0) // Bonus given to referred
  completedAt    DateTime? // When referral was completed (first purchase)
  expiresAt      DateTime? // Referral expiration
  createdAt      DateTime  @default(now())
  
  referrer User @relation("Referrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferredBy", fields: [referredId], references: [id], onDelete: Cascade)
  
  @@index([referrerId])
  @@index([referralCode])
  @@index([status])
}

model ReferralCode {
  id          String   @id @default(cuid())
  userId      String   @unique
  code        String   @unique
  usageCount  Int      @default(0)
  maxUsage    Int?     // null = unlimited
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  user User @relation("UserReferralCode", fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([code])
}

// ─────────────────────────────────────────────────────────────
// STREAK & LOYALTY SYSTEM
// ─────────────────────────────────────────────────────────────

model UserStreak {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastActivityAt  DateTime?
  totalActiveDays Int       @default(0)
  streakFreezes   Int       @default(0) // Freeze tickets
  frozenUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  user User @relation("UserStreak", fields: [userId], references: [id], onDelete: Cascade)
}

model VIPTier {
  id              String   @id @default(cuid())
  name            String   @unique // Bronze, Silver, Gold, Platinum
  minPoints       Int      // Minimum points required
  multiplier      Float    @default(1.0) // Points multiplier
  benefits        Json     // Array of benefit objects
  color           String   // Hex color for UI
  icon            String   // Emoji or icon
  order           Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  
  users UserVIPStatus[]
  
  @@index([minPoints])
  @@index([order])
}

model UserVIPStatus {
  id            String    @id @default(cuid())
  userId        String    @unique
  tierId        String
  totalSpent    Float     @default(0)
  lifetimePoints Int      @default(0)
  tierExpiry    DateTime? // When tier expires (if applicable)
  upgradedAt    DateTime  @default(now())
  
  user User    @relation("UserVIP", fields: [userId], references: [id], onDelete: Cascade)
  tier VIPTier @relation(fields: [tierId], references: [id])
  
  @@index([tierId])
}

// ─────────────────────────────────────────────────────────────
// HAPPY HOUR & PROMOTIONS
// ─────────────────────────────────────────────────────────────

model HappyHour {
  id           String   @id @default(cuid())
  dealerId     String?  // null = global
  name         String
  description  String?
  multiplier   Float    @default(2.0) // Points multiplier
  startTime    String   // HH:mm format
  endTime      String   // HH:mm format
  daysOfWeek   Json     // [0,1,2,3,4,5,6] - 0=Sunday
  isActive     Boolean  @default(true)
  validFrom    DateTime?
  validUntil   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  dealer User? @relation("DealerHappyHours", fields: [dealerId], references: [id], onDelete: Cascade)
  
  @@index([dealerId])
  @@index([isActive])
}

model SeasonalCampaign {
  id           String    @id @default(cuid())
  name         String
  description  String    @db.Text
  type         String    // BIRTHDAY, ANNIVERSARY, SEASONAL, SPECIAL
  multiplier   Float     @default(1.5)
  bonusPoints  Int       @default(0)
  discount     Float?    // Percentage discount
  imageUrl     String?
  conditions   Json?     // Eligibility conditions
  isActive     Boolean   @default(true)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime  @default(now())
  
  @@index([type])
  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
}

model UserBirthday {
  id           String    @id @default(cuid())
  userId       String    @unique
  birthDate    DateTime
  bonusGiven   Boolean   @default(false)
  lastBonusAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  
  user User @relation("UserBirthday", fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// SUSPICIOUS ACTIVITY & SECURITY
// ─────────────────────────────────────────────────────────────

model SuspiciousActivity {
  id          String   @id @default(cuid())
  userId      String?
  dealerId    String?
  cardId      String?
  type        String   // RAPID_SCAN, DUPLICATE_ENTRY, UNUSUAL_AMOUNT, IP_MISMATCH, etc.
  severity    String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  description String   @db.Text
  metadata    Json?    // Additional context
  ipAddress   String?
  userAgent   String?
  isResolved  Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime @default(now())
  
  user    User? @relation("UserSuspiciousActivities", fields: [userId], references: [id], onDelete: SetNull)
  dealer  User? @relation("DealerSuspiciousActivities", fields: [dealerId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([dealerId])
  @@index([type])
  @@index([severity])
  @@index([isResolved])
  @@index([createdAt])
}

model SecurityAlert {
  id          String   @id @default(cuid())
  type        String   // BRUTE_FORCE, UNUSUAL_LOGIN, MULTIPLE_FAILED_SCANS, etc.
  message     String
  severity    String   @default("INFO") // INFO, WARNING, ERROR, CRITICAL
  targetId    String?  // User/Dealer ID if applicable
  targetType  String?  // USER, DEALER, CARD
  metadata    Json?
  isRead      Boolean  @default(false)
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  @@index([type])
  @@index([severity])
  @@index([isRead])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// PUSH NOTIFICATIONS
// ─────────────────────────────────────────────────────────────

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  endpoint     String   @unique
  p256dh       String   // Public key
  auth         String   // Auth secret
  userAgent    String?
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())
  
  user User @relation("PushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isActive])
}

model PushNotificationLog {
  id             String   @id @default(cuid())
  userId         String
  subscriptionId String?
  title          String
  body           String
  data           Json?
  status         String   @default("SENT") // SENT, DELIVERED, FAILED, CLICKED
  error          String?
  sentAt         DateTime @default(now())
  deliveredAt    DateTime?
  clickedAt      DateTime?
  
  user User @relation("PushNotificationLogs", fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([sentAt])
}

// ─────────────────────────────────────────────────────────────
// OFFLINE MODE & SYNC
// ─────────────────────────────────────────────────────────────

model OfflineQueue {
  id          String   @id @default(cuid())
  dealerId    String
  action      String   // CREATE_CONSUMPTION, SCAN_CARD, etc.
  payload     Json     // Action data
  status      String   @default("PENDING") // PENDING, SYNCED, FAILED
  retries     Int      @default(0)
  error       String?
  queuedAt    DateTime @default(now())
  syncedAt    DateTime?
  
  dealer User @relation("DealerOfflineQueue", fields: [dealerId], references: [id], onDelete: Cascade)
  
  @@index([dealerId])
  @@index([status])
  @@index([queuedAt])
}

// ─────────────────────────────────────────────────────────────
// QUICK ACCESS & FAVORITES
// ─────────────────────────────────────────────────────────────

model DealerFavoriteProduct {
  id        String   @id @default(cuid())
  dealerId  String
  productId String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  
  dealer  User    @relation("DealerFavorites", fields: [dealerId], references: [id], onDelete: Cascade)
  product Product @relation("FavoritedBy", fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([dealerId, productId])
  @@index([dealerId])
  @@index([order])
}

model QuickScanPreset {
  id          String   @id @default(cuid())
  dealerId    String
  name        String
  productId   String?
  amount      Float?
  note        String?
  isDefault   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  
  dealer  User     @relation("DealerQuickPresets", fields: [dealerId], references: [id], onDelete: Cascade)
  product Product? @relation("QuickPresetProducts", fields: [productId], references: [id], onDelete: SetNull)
  
  @@index([dealerId])
  @@index([isDefault])
}

// ─────────────────────────────────────────────────────────────
// ANALYTICS ENHANCEMENTS
// ─────────────────────────────────────────────────────────────

model CustomerLifetimeValue {
  id                 String   @id @default(cuid())
  userId             String   @unique
  totalSpent         Float    @default(0)
  totalVisits        Int      @default(0)
  avgOrderValue      Float    @default(0)
  firstPurchaseAt    DateTime?
  lastPurchaseAt     DateTime?
  predictedChurn     Float?   // 0-1 probability
  churnRisk          String?  // LOW, MEDIUM, HIGH
  segmentId          String?
  calculatedAt       DateTime @default(now())
  
  user    User             @relation("CustomerCLV", fields: [userId], references: [id], onDelete: Cascade)
  segment CustomerSegment? @relation(fields: [segmentId], references: [id])
  
  @@index([predictedChurn])
  @@index([churnRisk])
}

model CustomerSegment {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  criteria    Json     // Segmentation rules
  color       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  
  customers CustomerLifetimeValue[]
}

model HeatmapData {
  id        String   @id @default(cuid())
  dealerId  String
  date      DateTime @db.Date
  hour      Int      // 0-23
  dayOfWeek Int      // 0-6 (Sunday = 0)
  count     Int      @default(0)
  revenue   Float    @default(0)
  createdAt DateTime @default(now())
  
  dealer User @relation("DealerHeatmap", fields: [dealerId], references: [id], onDelete: Cascade)
  
  @@unique([dealerId, date, hour])
  @@index([dealerId])
  @@index([date])
}
