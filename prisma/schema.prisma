/// Masada tek dokunuş: OK / CONCERN — şikâyet öncesi iç alarm
model TablePulse {
  id         String   @id @default(cuid())
  dealerId   String
  qrCodeId   String?
  tableCode  String? // "M7" — personel/masa etiketi (isim zorunlu değil)
  mood       String // OK | CONCERN
  customerId String?
  note       String?  @db.VarChar(400)
  /// Ekip içi kapanış (sağlık skoru 2.0)
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  dealer   User    @relation("DealerTablePulses", fields: [dealerId], references: [id], onDelete: Cascade)
  qrCode   QRCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  customer User?   @relation("CustomerTablePulses", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([dealerId, createdAt])
  @@index([qrCodeId])
}

/// Kısa süreli mutlu saat / flash — yakınımda listesi için kaba konum
model DealerFlashOffer {
  id              String   @id @default(cuid())
  dealerId        String
  title           String
  body            String   @db.Text
  offerType       String // PERCENT | FIXED_TRY | COMPLIMENTARY
  value           Float?
  validFrom       DateTime
  validTo         DateTime
  isActive        Boolean  @default(true)
  maxRedemptions  Int      @default(200)
  redemptionCount Int      @default(0)
  /// İşletme konumundan türetilir (~5 karakter geohash); müşteri sorgusunda gizlilik
  geohash5        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dealer User @relation("DealerFlashOffers", fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId, isActive, validTo])
  @@index([geohash5, isActive])
}

/// Haftalık tema özeti + önerilen aksiyon (iş kararı formatı)
model DealerWeeklyBrief {
  id                String   @id @default(cuid())
  dealerId          String
  weekStart         DateTime
  topThemes         Json // [{ "theme": "...", "count": n }]
  recommendedAction String   @db.Text
  createdAt         DateTime @default(now())

  dealer User @relation("DealerWeeklyBriefs", fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([dealerId, weekStart])
  @@index([dealerId])
}

/// Segment kampanya taslağı — bayi oluşturur, admin onayı ile gönderilebilir
model SegmentCampaignProposal {
  id          String    @id @default(cuid())
  dealerId    String
  segmentKey  String // sleeping | loyal | first_visit | ...
  title       String
  message     String    @db.Text
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | SENT
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  decidedById String?

  dealer User @relation("DealerSegmentProposals", fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId, status])
  @@index([status])
}

/// Telafi süreci şeffaflığı — müşteri zaman çizelgesi
model RemedyTimelineEvent {
  id            String   @id @default(cuid())
  remedyOfferId String
  kind          String // created | notified | accepted | completed | expired
  label         String
  meta          Json?
  createdAt     DateTime @default(now())

  remedyOffer RemedyOffer @relation(fields: [remedyOfferId], references: [id], onDelete: Cascade)

  @@index([remedyOfferId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// MÜŞTERİ DENEYİM — paylaşım, iyileştirme isteği, KVKK kuyruğu
// ─────────────────────────────────────────────────────────────

/// Arkadaşla paylaşılabilen anonim deneyim linki
model ExperienceShareToken {
  id        String   @id @default(cuid())
  token     String   @unique
  creatorId String
  dealerId  String
  caption   String?  @db.VarChar(200)
  mood      String   @default("good")
  expiresAt DateTime
  viewCount Int      @default(0)
  createdAt DateTime @default(now())

  creator User @relation("ExperienceSharesCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  dealer  User @relation("ExperienceSharesDealer", fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@index([token])
}

/// Şikâyet değil — iyileştirme isteği
model ImprovementRequest {
  id            String   @id @default(cuid())
  userId        String
  dealerId      String
  templateKey   String
  message       String   @db.Text
  status        String   @default("open")
  expectedHours Int      @default(48)
  createdAt     DateTime @default(now())

  user   User @relation("ImprovementRequestCustomer", fields: [userId], references: [id], onDelete: Cascade)
  dealer User @relation("ImprovementRequestDealer", fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId, status])
  @@index([userId])
}

/// KVKK başvuru kuyruğu (silme / erişim / düzeltme)
model DataSubjectRequest {
  id            String    @id @default(cuid())
  userId        String?
  email         String
  type          String
  status        String    @default("received")
  message       String?   @db.Text
  receiptSentAt DateTime?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status, createdAt])
}



// ─────────────────────────────────────────────────────────────
// İç Ekip Yönetimi (Notion/Asana tarzı) — yalnızca ADMIN alt-rolleri kullanır.
// ─────────────────────────────────────────────────────────────

model Department {
  id          String   @id @default(cuid())
  slug        String   @unique // "pazarlama", "gelistirme" — User.adminDepartment ile eşleşir
  name        String
  description String?
  color       String   @default("#8b5cf6")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     UserDepartment[]

  @@index([isActive])
}

// Ekip üyesi ↔ departman (çoklu). Bir kişi birden fazla departmanda olabilir.
// slug bazlı: mevcut adminDepartment (birincil/tekil) kodu uyumlu kalır; çoklu üyelik burada.
model UserDepartment {
  id             String   @id @default(cuid())
  userId         String
  departmentSlug String
  createdAt      DateTime @default(now())

  user       User       @relation("UserDepartments", fields: [userId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentSlug], references: [slug], onDelete: Cascade)

  @@unique([userId, departmentSlug])
  @@index([userId])
  @@index([departmentSlug])
}

model CompanyTask {
  id           String    @id @default(cuid())
  title        String
  description  String?   @db.Text
  status       String    @default("todo")   // todo | in_progress | review | done
  priority     String    @default("medium") // low | medium | high
  department   String?   // Department.slug (null = genel)
  weekKey      String? // "YYYY-Www" (haftalık pano; null = bu haftaya bağlı değil)
  tags         String? // virgülle ayrık etiketler ("acil,tasarım")
  assignedToId String?
  createdById  String
  dueAt        DateTime?
  completedAt  DateTime?
  // Bitiş-günü hatırlatma maili gönderildi mi (cron çift göndermesin — idempotent).
  dueReminderSentAt DateTime?
  // Onay akışı: üye görevi "review"e (Onayda) gönderir; yalnızca yönetici
  // onaylayıp "done" yapabilir. Reddedilirse "in_progress"e döner.
  submittedForReviewAt DateTime? // üye onaya gönderdiğinde damgalanır
  approvedById         String?   // onaylayan yönetici (done'a geçiren)
  approvedAt           DateTime? // onay zamanı
  reviewNote           String?   @db.Text // onay/red notu (yönetici geri bildirimi)
  // Zaman takibi (dakika cinsinden tahmini + harcanan)
  estimateMin  Int? // tahmini süre (dk)
  spentMin     Int      @default(0) // harcanan süre (dk)
  // Bağımlılık: bu görev başka bir göreve bağlı (o bitmeden başlanamaz)
  blockedById  String?
  // Tekrar: null|daily|weekly|monthly (weekKey bazlı cron ile klonlanır)
  recurrence   String?
  recurrenceParentId String? // bu tekrar örneğinin şablon görevi
  // Otomatik üretim izi (işletme verisinden gelen görevler)
  sourceType   String? // "manual" | "incident" | "churn" | "action-item" | "ai"
  sourceRef    String? // kaynak entity id (idempotent üretim için)
  archivedAt   DateTime? // arşivlenmiş görev (panoda gizli)
  coverColor   String?   // kart kapak rengi (görsel)
  coverIcon    String?   // kart ikonu (emoji)
  boardOrder   Int      @default(0) // kanban kolon içi manuel sıra
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTo  User? @relation("CompanyTaskAssignments", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy   User  @relation("CompanyTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  approvedBy  User? @relation("CompanyTaskApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  blockedBy   CompanyTask?  @relation("TaskDependency", fields: [blockedById], references: [id], onDelete: SetNull)
  blocking    CompanyTask[] @relation("TaskDependency")
  checklist   TaskChecklistItem[]
  comments    TaskComment[]
  activities  TaskActivity[]
  attachments TaskAttachment[]

  @@index([status])
  @@index([department])
  @@index([weekKey])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([blockedById])
  @@index([sourceType, sourceRef])
}

// Yeniden kullanılabilir görev şablonu (başlık/açıklama/öncelik/checklist iskeleti).
model TaskTemplate {
  id          String   @id @default(cuid())
  name        String   // şablon adı (ör. "Yeni özellik lansmanı")
  title       String   // üretilecek görev başlığı
  description String?  @db.Text
  priority    String   @default("medium")
  department  String?
  tags        String?
  estimateMin Int?
  checklist   String?  @db.Text // satır-ayrık alt görev metinleri
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation("TaskTemplateCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
}

// Ekip görev detayları: alt-görev (checklist), yorum, aktivite geçmişi.
model TaskChecklistItem {
  id           String    @id @default(cuid())
  taskId       String
  text         String
  done         Boolean   @default(false)
  order        Int       @default(0)
  assignedToId String?   // alt görev atanan kişi (zengin alt-görev)
  dueAt        DateTime? // alt görev bitiş tarihi
  createdAt    DateTime  @default(now())

  task       CompanyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedTo User?       @relation("ChecklistAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

model TaskComment {
  id        String    @id @default(cuid())
  taskId    String
  authorId  String
  text      String    @db.Text
  editedAt  DateTime? // düzenlenmişse damgalanır
  parentId  String?   // yanıt (thread) — hangi yoruma cevap
  attachmentPath String? // yoruma iliştirilmiş dosya (R2 URL)
  attachmentName String?
  createdAt DateTime  @default(now())

  task      CompanyTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User          @relation("TaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  parent    TaskComment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies   TaskComment[] @relation("CommentThread")
  reactions TaskCommentReaction[]

  @@index([taskId])
  @@index([parentId])
}

// Yorum reaksiyonları (emoji). Bir kullanıcı bir yoruma bir emoji ile bir kez.
model TaskCommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  emoji     String   // "👍" | "❤️" | "🎉" | "👀" | "🚀"
  createdAt DateTime @default(now())

  comment TaskComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User        @relation("TaskReactionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId, emoji])
  @@index([commentId])
}

// Kaydedilmiş görünüm: kullanıcının filtre+sıralama+grup setini adlandırıp saklar.
model TeamSavedView {
  id        String   @id @default(cuid())
  userId    String
  name      String
  config    Json     // { viewMode, department, status, priority, assignedTo, tag, q, sort, groupBy, mineOnly }
  isShared  Boolean  @default(false) // ekip geneline açık mı
  createdAt DateTime @default(now())

  user User @relation("TeamSavedViewUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Otomasyon kuralı: bir tetikleyici olayında bir aksiyon çalıştırır (durum→aksiyon).
model TeamAutomation {
  id         String   @id @default(cuid())
  name       String
  enabled    Boolean  @default(true)
  // Tetik: "status_changed" | "assigned" | "created" | "overdue"
  triggerType  String
  triggerValue String? // ör. status_changed için "done"
  // Aksiyon: "notify" | "add_tag" | "set_priority" | "assign" | "set_status"
  actionType   String
  actionValue  String? // ör. add_tag için "acil", assign için userId
  department   String?  // yalnız bu departman görevlerine (null=hepsi)
  createdById  String
  createdAt    DateTime @default(now())

  createdBy User @relation("TeamAutomationCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([triggerType, enabled])
}

// Yönetilen etiket havuzu: renkli, merkezi etiketler (serbest CSV yerine).
model TeamTag {
  id        String   @id @default(cuid())
  slug      String   @unique // normalize etiket ("acil")
  label     String   // görünen ad
  color     String   @default("#8b5cf6")
  createdAt DateTime @default(now())

  @@index([slug])
}

model TaskActivity {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  action    String   // "created" | "status" | "assigned" | "commented" | "checklist" | "priority" | "mentioned" | "attachment"
  detail    String?  // insan-okunur özet
  createdAt DateTime @default(now())

  task  CompanyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor User        @relation("TaskActivityActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
}

// Ekip görevine yüklenen dosya eki (resim/PDF/belge). Dosya public/images/uploads/tasks altında.
model TaskAttachment {
  id         String   @id @default(cuid())
  taskId     String
  uploadedById String
  filename   String   // orijinal ad (gösterim)
  path       String   // public URL yolu
  mime       String
  size       Int      // bayt
  createdAt  DateTime @default(now())

  task       CompanyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation("TaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([taskId])
}
