// ─────────────────────────────────────────────────────────────
// AI ANALYTICS MODELS
// ─────────────────────────────────────────────────────────────

model AIThemeCluster {
  id          String   @id @default(cuid())
  dealerId    String
  period      String // "2026-02", "2026-W06", "2026-02-06"
  theme       String // Ana tema: "Hizmet Kalitesi"
  subTheme    String? // Alt tema: "Personel Ilgisi"
  sentiment   String // positive, negative, neutral, mixed
  count       Int      @default(1)
  avgScore    Float    @default(0)
  trend       String? // up, down, stable
  trendValue  Float? // Degisim yuzdesi
  sampleTexts Json? // Ornek geri bildirim metinleri (max 5)
  keywords    Json? // Iliskili anahtar kelimeler
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([dealerId, period, theme, subTheme])
  @@index([dealerId])
  @@index([period])
  @@index([theme])
  @@index([sentiment])
}

model AIInsightReport {
  id              String   @id @default(cuid())
  dealerId        String
  period          String // "2026-02", "2026-W06"
  type            String // daily, weekly, monthly
  overallScore    Float // 0-100
  trend           String // up, down, stable
  trendValue      Float // Degisim yuzdesi
  totalFeedbacks  Int      @default(0)
  summary         String   @db.Text
  strengths       Json // [{ title, score, description, icon }]
  weaknesses      Json // [{ title, score, description, icon }]
  recommendations Json // [{ text, priority, impact, category }]
  alerts          Json? // [{ type, message, severity }]
  keyDrivers      Json? // [{ factor, impact, correlation }]
  predictedRating Float? // Tahmini gelecek donem puani
  keyMetrics      Json? // { responseRate, avgRating, nps, csat, ces }
  generatedAt     DateTime @default(now())

  @@unique([dealerId, period, type])
  @@index([dealerId])
  @@index([period])
  @@index([type])
  @@index([generatedAt])
}

model AIConversation {
  id        String   @id @default(cuid())
  dealerId  String
  dealer    User     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  title     String?
  messages  Json // [{ role: "user"|"assistant", content: "...", timestamp }]
  context   Json? // Sohbet baglami (filtreler, secili donem vs.)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealerId])
  @@index([createdAt])
}

model AISettings {
  id                   String   @id @default(cuid())
  dealerId             String   @unique
  dealer               User     @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  isEnabled            Boolean  @default(true)
  autoAnalyze          Boolean  @default(true) // Otomatik analiz
  analysisLanguage     String   @default("tr")
  sentimentEnabled     Boolean  @default(true)
  emotionEnabled       Boolean  @default(true)
  topicEnabled         Boolean  @default(true)
  intentEnabled        Boolean  @default(true)
  urgencyEnabled       Boolean  @default(true)
  entityEnabled        Boolean  @default(true)
  toxicityEnabled      Boolean  @default(true)
  churnEnabled         Boolean  @default(true)
  themeClusterEnabled  Boolean  @default(true)
  weeklyReportEnabled  Boolean  @default(true)
  monthlyReportEnabled Boolean  @default(true)
  alertOnToxic         Boolean  @default(true)
  alertOnUrgent        Boolean  @default(true) // urgency > 0.7
  alertOnChurnRisk     Boolean  @default(true) // churnRisk > 0.7
  customPrompt         String?  @db.Text // Dealer ozel prompt eklentisi
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
