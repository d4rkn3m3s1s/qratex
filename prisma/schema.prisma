  ipFingerprint    String?
  userRoleSnapshot String? // ADMIN, DEALER, CUSTOMER, STAFF, ANON
  userMessage      String   @db.Text
  assistantMessage String   @db.Text
  model            String   @default("llama-3.3-70b-versatile")
  latencyMs        Int?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([ipFingerprint, createdAt])
}

model AgentRun {
  id             String   @id @default(cuid())
  goal           String   @db.Text
  status         String   @default("completed") // running, completed, failed
  createdById    String?
  context        Json?
  finalDecision  String?  @db.Text
  winnerAgent    String?
  confidence     Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages  AgentMessage[]
  proposals AgentProposal[]
  decisions AgentDecision[]

  @@index([status])
  @@index([createdAt])
  @@index([createdById])
}

model AgentMessage {
  id        String   @id @default(cuid())
  runId     String
  agentName String
  role      String // proposal, critique, consensus, system
  content   String   @db.Text
  round     Int      @default(1)
  score     Float?
  metadata  Json?
  createdAt DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, round])
  @@index([agentName])
}

model AgentProposal {
  id             String   @id @default(cuid())
  runId          String
  agentName      String
  proposalType   String
  title          String
  details        String   @db.Text
  expectedImpact Float?
  confidence     Float?
  priority       String   @default("medium")
  createdAt      DateTime @default(now())

  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([agentName])
  @@index([priority])
}

model AgentDecision {
  id               String   @id @default(cuid())
  runId            String
  winnerAgent      String
  rationale        String   @db.Text
  suggestedActions Json
  consensusScore   Float?
  createdAt        DateTime @default(now())

  run      AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  outcomes AgentOutcome[]

  @@index([runId])
  @@index([winnerAgent])
}

model AgentOutcome {
  id          String   @id @default(cuid())
  decisionId  String
  metricName  String
  metricDelta Float
  successScore Float?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  decision AgentDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  @@index([decisionId])
  @@index([metricName])
}

model AIEmbedding {
  id         String   @id @default(cuid())
  feedbackId String   @unique
  dealerId   String
  vector     Json
  model      String
  dimension  Int
  createdAt  DateTime @default(now())

  feedback Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  dealer   User     @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@index([createdAt])
