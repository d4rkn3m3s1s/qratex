model AIUsageLog {
  id           String   @id @default(cuid())
  dealerId     String?
  action       String // analyze, insights, chat, bulk_analyze, theme_cluster
  model        String // Kullanilan model
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  latencyMs    Int      @default(0)
  success      Boolean  @default(true)
  error        String?
  createdAt    DateTime @default(now())

  @@index([dealerId])
  @@index([action])
  @@index([createdAt])
  @@index([success])
}

/// QRA floating chat — kötüye kullanım incelemesi ve admin denetimi
model QraChatLog {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
