  dealer User? @relation("DealerSuspiciousActivities", fields: [dealerId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([dealerId])
  @@index([type])
  @@index([severity])
  @@index([isResolved])
  @@index([createdAt])
}

model SecurityAlert {
