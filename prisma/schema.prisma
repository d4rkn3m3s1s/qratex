}

// ─────────────────────────────────────────────────────────────
// INNOVATION PLATFORM (sessiz sinyal, flash teklif, özet, segment, telafi zaman çizelgesi)
// ─────────────────────────────────────────────────────────────

/// Masada tek dokunuş: OK / CONCERN — şikâyet öncesi iç alarm
model TablePulse {
  id         String   @id @default(cuid())
  dealerId   String
  qrCodeId   String?
  tableCode  String? // "M7" — personel/masa etiketi (isim zorunlu değil)
  mood       String // OK | CONCERN
  customerId String?
  note       String?  @db.VarChar(400)
  /// Ekip içi kapanış (sağlık skoru 2.0)
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  dealer   User    @relation("DealerTablePulses", fields: [dealerId], references: [id], onDelete: Cascade)
  qrCode   QRCode? @relation(fields: [qrCodeId], references: [id], onDelete: SetNull)
  customer User?   @relation("CustomerTablePulses", fields: [customerId], references: [id], onDelete: SetNull)

  @@index([dealerId, createdAt])
  @@index([qrCodeId])
}

/// Kısa süreli mutlu saat / flash — yakınımda listesi için kaba konum
model DealerFlashOffer {
  id              String   @id @default(cuid())
  dealerId        String
  title           String
  body            String   @db.Text
  offerType       String // PERCENT | FIXED_TRY | COMPLIMENTARY
  value           Float?
  validFrom       DateTime
  validTo         DateTime
  isActive        Boolean  @default(true)
  maxRedemptions  Int      @default(200)
  redemptionCount Int      @default(0)
  /// İşletme konumundan türetilir (~5 karakter geohash); müşteri sorgusunda gizlilik
  geohash5        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dealer User @relation("DealerFlashOffers", fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId, isActive, validTo])
  @@index([geohash5, isActive])
}

/// Haftalık tema özeti + önerilen aksiyon (iş kararı formatı)
model DealerWeeklyBrief {
  id                String   @id @default(cuid())
  dealerId          String
  weekStart         DateTime
  topThemes         Json // [{ "theme": "...", "count": n }]
  recommendedAction String   @db.Text
  createdAt         DateTime @default(now())

  dealer User @relation("DealerWeeklyBriefs", fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([dealerId, weekStart])
  @@index([dealerId])
}

/// Segment kampanya taslağı — bayi oluşturur, admin onayı ile gönderilebilir
model SegmentCampaignProposal {
  id          String    @id @default(cuid())
  dealerId    String
  segmentKey  String // sleeping | loyal | first_visit | ...
  title       String
  message     String    @db.Text
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | SENT
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?
  decidedById String?

  dealer User @relation("DealerSegmentProposals", fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId, status])
  @@index([status])
}

/// Telafi süreci şeffaflığı — müşteri zaman çizelgesi
model RemedyTimelineEvent {
  id            String   @id @default(cuid())
  remedyOfferId String
  kind          String // created | notified | accepted | completed | expired
  label         String
  meta          Json?
  createdAt     DateTime @default(now())

  remedyOffer RemedyOffer @relation(fields: [remedyOfferId], references: [id], onDelete: Cascade)

  @@index([remedyOfferId, createdAt])
}

// ─────────────────────────────────────────────────────────────
// MÜŞTERİ DENEYİM — paylaşım, iyileştirme isteği, KVKK kuyruğu
// ─────────────────────────────────────────────────────────────

/// Arkadaşla paylaşılabilen anonim deneyim linki
model ExperienceShareToken {
  id        String   @id @default(cuid())
  token     String   @unique
  creatorId String
  dealerId  String
  caption   String?  @db.VarChar(200)
  mood      String   @default("good")
  expiresAt DateTime
  viewCount Int      @default(0)
  createdAt DateTime @default(now())

  creator User @relation("ExperienceSharesCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  dealer  User @relation("ExperienceSharesDealer", fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@index([token])
}

/// Şikâyet değil — iyileştirme isteği
model ImprovementRequest {
  id            String   @id @default(cuid())
  userId        String
  dealerId      String
  templateKey   String
  message       String   @db.Text
  status        String   @default("open")
  expectedHours Int      @default(48)
  createdAt     DateTime @default(now())

  user   User @relation("ImprovementRequestCustomer", fields: [userId], references: [id], onDelete: Cascade)
  dealer User @relation("ImprovementRequestDealer", fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId, status])
  @@index([userId])
}

/// KVKK başvuru kuyruğu (silme / erişim / düzeltme)
model DataSubjectRequest {
  id            String    @id @default(cuid())
  userId        String?
  email         String
  type          String
  status        String    @default("received")
  message       String?   @db.Text
  receiptSentAt DateTime?
  createdAt     DateTime  @default(now())
  processedAt   DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([status, createdAt])
}


