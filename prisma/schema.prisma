generator client {
  provider      = "prisma-client-js"
  output        = "../generated-prisma-client"
  // Tek hedef: aynı OS’ta `native` + `rhel` iki Linux motoru üretip her lambda’da ~2× şişiriyordu.
  // Vercel build Linux’ta çalışır; runtime da Linux — `native` yeterli.
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  // Runtime: pooler URL (PgBouncer, connection_limit=1). Migration/introspection: DIRECT_URL
  // (pooler'sız 5432 — PgBouncer transaction mode DDL'i desteklemez). DIRECT_URL yoksa Prisma
  // url'e düşer, mevcut davranış korunur (geriye uyumlu).
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────────────────────
// AUTH MODELS
// ─────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  DEALER
  CUSTOMER
  STAFF
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  password      String?
  role          Role      @default(CUSTOMER)
  // İç ekip yönetimi — yalnızca role=ADMIN için anlamlı (nullable = mevcut satırları etkilemez)
  adminDepartment String? // "pazarlama" | "gelistirme" | "destek" | ... (Department.slug)
  adminTeamRole   String? // "yonetici" | "uye"
  // Profilde vitrin edilen "ana karakter" rozeti (character-badges). Kullanıcı seçer.
  featuredCharacterBadgeId String?
  // Tür×kanal bildirim tercihleri (JSON). Şekil: { [group]: { app?: boolean; email?: boolean } }
  // Gruplar: 'character' | 'team' | 'campaign' | 'reminder' (bkz. lib/notification-prefs.ts).
  // Nullable + boş → HER ŞEY AÇIK varsayılır (mevcut satırları/davranışı etkilemez).
  notificationPrefs Json?
  points        Int       @default(0)
  level         Int       @default(1)
  xp            Int       @default(0)
  isHallOfFame  Boolean   @default(false)
  biography     String?   @db.Text

  // ── GÜNLÜK GİRİŞ SERİSİ (login/aktivite streak) ──────────────────────────
  // MİNİ OYUN streak'inden (MiniGameSession/GameStreakClaim) ve UserStreak
  // loyalty tablosundan BAĞIMSIZ. Kullanıcı customer paneline her "dokunduğu"
  // gün (touchLoginStreak, lib/login-streak.ts) günde bir kez ilerler.
  // Hepsi nullable/default → mevcut satırları bozmaz.
  loginStreakCount              Int       @default(0) // mevcut ardışık gün sayısı
  loginStreakLongest            Int       @default(0) // ulaşılan en uzun seri
  loginStreakLastDay            DateTime? // son sayılan günün tarihi (gün bazlı karşılaştırma)
  loginStreakClaimedMilestones  Json?     // idempotent ödül bayrağı, ör. [3, 7]
  referralMilestonesClaimed     Json?     // referral kademe ödül bayrağı, ör. [3, 5]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts         Account[]
  sessions         Session[]
  authEmailTokens  AuthEmailToken[]
  badges        UserBadge[]
  quests        UserQuest[]
  rewards       UserReward[]
  feedbacks     Feedback[]
  qrCodes       QRCode[]
  notifications Notification[]
  uploads       FileUpload[]
  analytics     AnalyticsEvent[]
  auditLogs     AuditLog[]
  donations     Donation[]
  dailySpins    DailySpin[]

  // Dealer specific
  businessName         String?
  businessLogo         String?
  businessDesc         String?
  address              String?
  latitude             Float?
  longitude            Float?
  businessHours        String? @db.Text // JSON: { "mon": { "open": "09:00", "close": "18:00" }, ... }
  defaultReplyTemplate String? @db.Text
  preferredLanguage    String? @default("tr")
  holidayMode          Boolean @default(false)
  /// Bayi: otomatik telafi eşikleri ve bütçe (JSON)
  dealerRemedyAutomation Json?
  /// Bayi: tahminsel churn müdahale eşikleri (JSON: enabled, churnThreshold, inactiveDays, autoFlashOffer)
  dealerChurnIntervention Json?

  // Admin Features (Insights, Fraud, A/B Testing)
  businessCategory String? // e.g. "cafe", "restaurant" for global insights
  fraudStatus      String  @default("clean") // "clean", "flagged", "shadow_ban"
  fraudScore       Float?  @default(0.0)
  abCohort         String? // for Gamification A/B tests: A, B, C...

  // Trust Score (kötü niyetli yorumcu tespiti). 100 = tam güven, düşük = şüpheli.
  // Yorum gönderiminde sinyallerle güncellenir; bayi/admin müşteri analizinde görünür.
  trustScore       Int      @default(100)
  trustTier        String   @default("trusted") // "trusted" | "neutral" | "watch" | "low"
  trustUpdatedAt   DateTime?

  // Billing: bayinin etkin fiyatlandırma planı (null = varsayılan/ücretsiz kademe)
  pricingPlanId String?
  pricingPlan   PricingPlan? @relation("DealerPricingPlan", fields: [pricingPlanId], references: [id], onDelete: SetNull)

  // Stripe abonelik durumu (webhook ile senkron tutulur)
  stripeCustomerId             String?   @unique
  stripeSubscriptionId         String?   @unique
  subscriptionStatus           String? // active, trialing, past_due, canceled, incomplete
  subscriptionCurrentPeriodEnd DateTime?

  // Physical Card System Relations
  physicalCards        PhysicalCard[]      @relation("CustomerCards")
  customerConsumptions Consumption[]       @relation("CustomerConsumptions")
  dealerConsumptions   Consumption[]       @relation("DealerConsumptions")
  customerReviews      ConsumptionReview[] @relation("CustomerReviews")
  dealerCategories     ProductCategory[]   @relation("DealerCategories")
  dealerProducts       Product[]           @relation("DealerProducts")
  cardAuditLogs        CardAuditLog[]      @relation("CardAuditLogs")
  createdBatches       CardBatch[]         @relation("CreatedBatches")

  // New Feature Relations
  referralsMade             Referral[]                 @relation("Referrals")
  referredBy                Referral?                  @relation("ReferredBy")
  referralCode              ReferralCode?              @relation("UserReferralCode")
  streak                    UserStreak?                @relation("UserStreak")
  vipStatus                 UserVIPStatus?             @relation("UserVIP")
  birthday                  UserBirthday?              @relation("UserBirthday")
  happyHours                HappyHour[]                @relation("DealerHappyHours")
  suspiciousActivities      SuspiciousActivity[]       @relation("UserSuspiciousActivities")
  dealerAlerts              SuspiciousActivity[]       @relation("DealerSuspiciousActivities")
  pushSubscriptions         PushSubscription[]         @relation("PushSubscriptions")
  pushNotifications         PushNotificationLog[]      @relation("PushNotificationLogs")
  offlineQueue              OfflineQueue[]             @relation("DealerOfflineQueue")
  favoriteProducts          DealerFavoriteProduct[]    @relation("DealerFavorites")
  quickPresets              QuickScanPreset[]          @relation("DealerQuickPresets")
  customerCLV               CustomerLifetimeValue?     @relation("CustomerCLV")
  heatmapData               HeatmapData[]              @relation("DealerHeatmap")
  incidents                 Incident[] // dealer'ın kriz/incident kayıtları
  incidentAssignments       Incident[]                 @relation("IncidentAssignments")
  csmTasks                  CSMTask[] // dealer'a atanan CSM görevleri
  csmTasksAssigned          CSMTask[]                  @relation("CSMTaskAssignments")
  actionItems               ActionItem[] // dealer'ın aksiyon öğeleri
  actionItemAssignments     ActionItem[]               @relation("ActionItemAssignments")
  remedyOffersSent          RemedyOffer[]              @relation("DealerRemedyOffers")
  remedyOffersReceived      RemedyOffer[]              @relation("CustomerRemedyOffers")
  aiSettings                AISettings?
  aiConversations           AIConversation[]
  aiEmbeddings              AIEmbedding[]
  aiCorrections             AIFeedbackCorrection[]
  aiLearningProfile         AIDealerLearningProfile?
  dailyStats                DailyDealerStats[]
  dealerOnboardingEvents    DealerOnboardingEvent[]
  webhooksCreated           Webhook[]
  apiKeysCreated            ApiKey[]
  surpriseBoxesReceived     UserSurpriseBox[]          @relation("UserSurpriseBoxesReceived")
  surpriseBoxesSent         UserSurpriseBox[]          @relation("UserSurpriseBoxesSent")
  // Staff (employee) — belongs to one dealer
  staffProfile              DealerStaff?
  // Dealer — has many staff
  staffMembers              DealerStaff[]              @relation("DealerStaffMembers")
  trainingModules           TrainingModule[]           @relation("DealerTrainingModules")
  checklistTemplates        ChecklistTemplate[]        @relation("DealerChecklistTemplates")
  // Staff: tasks/shifts/leave assigned to this user
  staffTasksAssigned        StaffTask[]                @relation("StaffTaskAssignments")
  companyTasksAssigned      CompanyTask[]              @relation("CompanyTaskAssignments")
  companyTasksCreated       CompanyTask[]              @relation("CompanyTaskCreator")
  companyTasksApproved      CompanyTask[]              @relation("CompanyTaskApprover")
  taskCommentsAuthored      TaskComment[]              @relation("TaskCommentAuthor")
  taskActivitiesActed       TaskActivity[]             @relation("TaskActivityActor")
  taskAttachmentsUploaded   TaskAttachment[]           @relation("TaskAttachmentUploader")
  taskTemplatesCreated      TaskTemplate[]             @relation("TaskTemplateCreator")
  teamDepartments           UserDepartment[]           @relation("UserDepartments")
  taskCommentReactions      TaskCommentReaction[]      @relation("TaskReactionUser")
  checklistAssignments      TaskChecklistItem[]        @relation("ChecklistAssignee")
  teamSavedViews            TeamSavedView[]            @relation("TeamSavedViewUser")
  teamAutomationsCreated    TeamAutomation[]           @relation("TeamAutomationCreator")
  staffShifts               StaffShift[]
  staffLeaveRequests        StaffLeaveRequest[]
  staffTrainingCompletions  StaffTrainingCompletion[]
  staffChecklistCompletions StaffChecklistCompletion[]
  // Dealer: created tasks, shifts, leave requests
  staffTasksCreated         StaffTask[]                @relation("DealerStaffTasks")
  staffShiftsCreated        StaffShift[]               @relation("DealerStaffShifts")
  staffLeaveRequestsCreated StaffLeaveRequest[]        @relation("DealerStaffLeaveRequests")
  // Müşteri: favori işletmeler (Ö2)
  favoriteDealers           CustomerFavoriteDealer[]   @relation("CustomerFavorites")
  favoritedByCustomers      CustomerFavoriteDealer[]   @relation("DealerFavoritedBy")
  autoReplyRules            AutoReplyRule[]            @relation("DealerAutoReplyRules")
  surveys                   Survey[]                   @relation("DealerSurveys")
  campaigns                 Campaign[]                 @relation("DealerCampaigns")
  dashboardLayout           DashboardLayout?           @relation("UserDashboardLayout")
  automationRulesCreated    UserAutomationRule[]       @relation("AutomationRulesCreatedBy")
  automationRulesUpdated    UserAutomationRule[]       @relation("AutomationRulesUpdatedBy")
  automationRulesApproved   UserAutomationRule[]       @relation("AutomationRulesApprovedBy")
  automationRunsTriggered   UserAutomationRun[]        @relation("AutomationRunsTriggeredBy")
  qraChatLogs               QraChatLog[]
  /// Masa sessiz sinyali (işletme tarafı listeler)
  dealerTablePulses         TablePulse[]              @relation("DealerTablePulses")
  dealerFlashOffers         DealerFlashOffer[]        @relation("DealerFlashOffers")
  dealerWeeklyBriefs        DealerWeeklyBrief[]       @relation("DealerWeeklyBriefs")
  dealerSegmentProposals    SegmentCampaignProposal[] @relation("DealerSegmentProposals")
  dealerLocations           DealerLocation[]          @relation("DealerLocations")
  dealerRemedyTemplates     RemedyTemplate[]          @relation("DealerRemedyTemplates")
  miniGameSessions          MiniGameSession[]         @relation("UserMiniGameSessions")
  /// Müşteri masadan sinyal gönderdiyse
  customerTablePulses       TablePulse[]              @relation("CustomerTablePulses")
  experienceSharesCreated   ExperienceShareToken[]   @relation("ExperienceSharesCreated")
  experienceSharesForDealer ExperienceShareToken[] @relation("ExperienceSharesDealer")
  improvementRequestsAsCustomer ImprovementRequest[] @relation("ImprovementRequestCustomer")
  improvementRequestsForDealer  ImprovementRequest[] @relation("ImprovementRequestDealer")
  dataSubjectRequests           DataSubjectRequest[]

  // Squads Relations (Customer)
  ownedSquad           Squad?                  @relation("SquadOwner")
  squadMemberships     SquadMember[]           @relation("UserSquadMemberships")
  equippedCosmetics    UserCosmetic[]          @relation("UserCosmetics")
  giftsSent            UserCosmetic[]          @relation("UserGiftsSent")
  battleParticipations SquadBattleParticipant[]

  // Custom cosmetics
  customFrameColor     String?

  // 2FA
  twoFactorSecret    String?
  twoFactorEnabled   Boolean @default(false)
  twoFactorVerifiedAt DateTime? // 2FA'nın etkinleştirildiği an

  twoFactorRecoveryCodes TwoFactorRecoveryCode[] @relation("UserRecoveryCodes")

  @@index([email])
  @@index([role])
}

// Müşteri favori işletmeler (Ö2)
model CustomerFavoriteDealer {
  id        String   @id @default(cuid())
  userId    String // müşteri
  dealerId  String // işletme (User role=DEALER)
  createdAt DateTime @default(now())

  user   User @relation("CustomerFavorites", fields: [userId], references: [id], onDelete: Cascade)
  dealer User @relation("DealerFavoritedBy", fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([userId, dealerId])
  @@index([userId])
  @@index([dealerId])
}

// Admin tarafından kullanıcıya gönderilen sürpriz kutu (isimle veya rastgele)
model UserSurpriseBox {
  id           String    @id @default(cuid())
  userId       String // alıcı müşteri
  sentByUserId String? // gönderen admin
  title        String // "Sürpriz Ödülünüz!"
  message      String?   @db.Text
  couponCode   String?
  points       Int       @default(0)
  rewardType   String? // coupon, points, badge, reward
  metadata     Json? // ek veri
  /// Günlük giriş kutusu için "YYYY-MM-DD" (UTC). Yalnızca otomatik günlük kutuda dolu;
  /// hediye/manuel kutularda null. @@unique ile aynı gün ikinci kez üretimi engeller (çift ödül fix).
  dayKey       String?
  openedAt     DateTime? // null = henüz açılmadı
  createdAt    DateTime  @default(now())

  user   User  @relation("UserSurpriseBoxesReceived", fields: [userId], references: [id], onDelete: Cascade)
  sentBy User? @relation("UserSurpriseBoxesSent", fields: [sentByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, dayKey])
  @@index([userId])
  @@index([openedAt])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Token replay: JWT jti + IP/UA ile farklı cihazdan kullanım tespiti
model SessionTokenUsage {
  id            String   @id @default(cuid())
  jti           String // JWT ID (session fixation için üretilen)
  ipHash        String // SHA256(ip) ilk 16 karakter
  userAgentHash String // SHA256(ua) ilk 16 karakter
  lastSeen      DateTime @default(now())
  createdAt     DateTime @default(now())

  @@unique([jti])
  @@index([lastSeen])
}

// Idempotency: kritik POST'larda tekrar isteği çift işlem engelleme
model IdempotencyKey {
  id           String   @id @default(cuid())
  key          String   @unique // Idempotency-Key header değeri
  route        String // Örn: feedback, remedy, spin
  statusCode   Int // Cached response status
  responseBody String   @db.Text // JSON string
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([expiresAt])
}

// Outbox: DB yazımı + event publish atomik olsun
model OutboxEvent {
  id           String    @id @default(cuid())
  eventName    String // feedback/created vb.
  payload      Json // event data
  processedAt  DateTime?
  attemptCount Int       @default(0) // başarısız işleme denemesi sayısı (DLQ eşiği için)
  lastError    String?   @db.Text // son hata mesajı (görünürlük)
  deadAt       DateTime? // DLQ: eşiği aşan poison event bir daha denenmez
  createdAt    DateTime  @default(now())

  @@index([processedAt])
  @@index([eventName])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Şifre sıfırlama ve magic link (tek kullanımlık, hash saklanır)
model AuthEmailToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  purpose    String // password_reset | magic_login
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// 2FA kurtarma kodları — yetkilendirici cihaz kaybında giriş. Tek kullanımlık,
/// hash saklanır (AuthEmailToken deseni). Setup'ta 10 adet üretilir.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation("UserRecoveryCodes", fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// GAMIFICATION MODELS
// ─────────────────────────────────────────────────────────────

// ------ 1. SQUADS & CLANS (SOSYAL MOD) ------
model Squad {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  inviteCode  String   @unique // Örn: JKL58M
  totalPoints Int      @default(0)
  ownerId     String   @unique
  /// Haftalık ekip hedefi (örn. 5 geri bildirim); progress haftalık sıfırlanır
  weeklyTeamTarget   Int       @default(5)
  weeklyTeamProgress Int       @default(0)
  weeklyGoalResetAt  DateTime?
  treasuryPoints     Int       @default(0)
  isFrozen           Boolean   @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner   User          @relation("SquadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members SquadMember[]
  battlesAsSquad1 SquadBattle[] @relation("Squad1Battles")
  battlesAsSquad2 SquadBattle[] @relation("Squad2Battles")
  battleParticipations SquadBattleParticipant[]

  @@index([ownerId])
  @@index([totalPoints])
}

model SquadMember {
  id       String   @id @default(cuid())
  userId   String
  squadId  String
  joinedAt DateTime @default(now())

  user  User  @relation("UserSquadMemberships", fields: [userId], references: [id], onDelete: Cascade)
  squad Squad @relation(fields: [squadId], references: [id], onDelete: Cascade)

  @@unique([userId, squadId])
  @@index([userId])
  @@index([squadId])
}

// ------ 2. SQUAD BATTLES (KLAN SAVAŞLARI) ------
model SquadBattle {
  id          String   @id @default(cuid())
  squad1Id    String
  squad2Id    String
  status      String   @default("pending") // pending, active, completed, cancelled
  startTime   DateTime
  endTime     DateTime
  squad1Score Int      @default(0)
  squad2Score Int      @default(0)
  winnerId    String?
  rewardPool  Int      @default(0)
  /// Ödül havuzu meydan okuyandan TAHSİL EDİLDİ mi (escrow). true ise kazanana
  /// ödenir / kazanan yoksa veya savaş iptal/ret olursa challenger'a iade edilir.
  /// false = eski/admin savaşları (escrow yok → ödeme yapılmaz, mint engellenir).
  rewardFunded   Boolean  @default(false)
  /// Escrow iade edildi mi (idempotent refund guard).
  rewardRefunded Boolean  @default(false)
  /// Meydan okumayı başlatan kullanıcı (challenge akışı). null = admin oluşturdu.
  challengedById String?
  /// Rakip klan kabul ettiğinde dolar (status: pending → active).
  acceptedAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  squad1 Squad @relation("Squad1Battles", fields: [squad1Id], references: [id], onDelete: Cascade)
  squad2 Squad @relation("Squad2Battles", fields: [squad2Id], references: [id], onDelete: Cascade)
  participants SquadBattleParticipant[]

  // Cron süresi-dolan taraması (status='active'/'pending' + endTime<=now) en hot
  // sorgu; status tek-sütun prefix'i de bu composite'ten faydalanır.
  @@index([status, endTime])
  // Challenge "açık savaş var mı" kontrolü squad1Id/squad2Id + status filtreler.
  @@index([squad1Id, status])
  @@index([squad2Id, status])
}

model SquadBattleParticipant {
  id        String   @id @default(cuid())
  battleId  String
  squadId   String
  userId    String
  score     Int      @default(0)
  createdAt DateTime @default(now())

  battle SquadBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  squad  Squad       @relation(fields: [squadId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
}

/// Mini oyun (Pacman tarzı yıldız toplama) oturumu. Günde 1 hak için
/// @@unique([userId, gameType, dayKey]); sunucu ödülü doğrular (client'a güvenmez).
model MiniGameSession {
  id             String    @id @default(cuid())
  userId         String
  gameType       String    @default("pacman")
  dayKey         String // "YYYY-MM-DD" (UTC) — günlük tek oturum
  status         String    @default("active") // active | completed | failed
  starsCollected Int       @default(0)
  rewardPoints   Int       @default(0)
  startedAt      DateTime  @default(now())
  completedAt    DateTime?

  user User @relation("UserMiniGameSessions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, gameType, dayKey])
  @@index([userId])
  // Leaderboard groupBy: gameType + status (userId YOK) → tek-sütun userId index'i
  // bu sorguda işe yaramıyordu, tam-tablo taraması oluyordu.
  @@index([gameType, status])
  // Streak / achievement-stats: userId + status filtreler (status='completed').
  @@index([userId, status])
}

/// Admin'in mini oyun registry'sini (lib/minigame-config.ts MINI_GAMES) ezdiği
/// override katmanı. gameType UNIQUE; her satır TEK bir oyunu temsil eder.
/// Override alanları NULL ise registry varsayılanı kullanılır (effective-config
/// birleştirmesi lib/minigame-config-effective.ts'de). enabled=false → oyun
/// hub'da gizlenir ve server start'ı reddeder. Ödül/eşik/süre DAİMA sunucuda
/// bu effective değerlerden hesaplanır (client'a güvenilmez).
model MiniGameConfig {
  id        String  @id @default(cuid())
  gameType  String  @unique
  /// Oyun açık mı (hub'da görünür + oynanabilir).
  enabled   Boolean @default(true)

  // --- Ödül & anti-cheat override'ları (null = registry varsayılanı) ---
  rewardPoints    Int?
  rewardXp        Int?
  rewardThreshold Int?
  minDurationSec  Int?
  maxScore        Int?

  // --- Görsel override'lar (null/boş = registry varsayılanı) ---
  title       String?
  description String?
  emoji       String?
  accent      String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model GamificationSettings {
  id                String   @id @default(cuid())
  xpMultiplier      Float    @default(1.0)
  pointMultiplier   Float    @default(1.0)
  dailyXpCap        Int      @default(5000)
  levelUpRewardBase Int      @default(100)
  isSeasonActive    Boolean  @default(true)
  seasonName        String?
  seasonEndsAt      DateTime?
  updatedAt         DateTime @updatedAt
}

model AITone {
  id           String   @id @default(cuid())
  slug         String   @unique // formal, friendly, humorous, etc.
  name         String
  systemPrompt String   @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ------ 3. COSMETIC ITEMS (ROZET KABİNESİ & AVATAR) ------
model CosmeticItem {
  id          String   @id @default(cuid())
  /// Admin vitrin / tohum ürünleri için sabit anahtar (ör. demo-aurora-frame)
  slug        String?  @unique
  name        String
  description String?
  type        String // "avatar_frame", "profile_badge", "profile_background"
  price       Int      @default(0) // XP / Puan bedeli
  imageUrl    String?
  rarity      String   @default("common")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  owners UserCosmetic[]

  @@index([type])
}

model UserCosmetic {
  id             String   @id @default(cuid())
  userId         String
  cosmeticId     String
  isEquipped     Boolean  @default(false)
  isPinned       Boolean  @default(false)
  giftedByUserId String?
  giftMessage    String?  @db.Text
  acquiredAt     DateTime @default(now())

  user         User         @relation("UserCosmetics", fields: [userId], references: [id], onDelete: Cascade)
  cosmetic     CosmeticItem @relation(fields: [cosmeticId], references: [id], onDelete: Cascade)
  giftedByUser User?        @relation("UserGiftsSent", fields: [giftedByUserId], references: [id], onDelete: SetNull)

  @@unique([userId, cosmeticId])
  @@index([userId])
  @@index([giftedByUserId])
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  category    String   @default("general")
  rarity      String   @default("common") // common, rare, epic, legendary
  requirement Json // { type: "feedback_count", value: 10 }
  pointCost   Int? // puanla açılabilir (null = sadece requirement ile)
  isActive    Boolean  @default(true)
  // Admin renk kontrolü (opsiyonel). Doluysa rozet kartında rarity paletini EZER —
  // böylece admin rozet-başına canlı renk/arka plan verebilir. null = rarity varsayılanı.
  color       String? // vurgu rengi (hex, ör. "#d946ef") — çerçeve/metin/parıltı
  bgColor     String? // arka plan/gradient bitiş rengi (hex) — kart zemini
  // Sürpriz rozet: true ise müşteride KAZANILANA KADAR GİZLİ (dizi karakterleri gibi).
  // Kazanılınca koleksiyonda açılır + "sürpriz rozet!" hissi. Admin toggle'ı. false = normal.
  hiddenUntilEarned Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserBadge[]

  @@index([category])
  @@index([isActive])
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  isPinned Boolean  @default(false)
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model Quest {
  id          String    @id @default(cuid())
  name        String
  description String
  icon        String
  type        String    @default("daily") // daily, weekly, special, mystery
  requirement Json // { type: "give_feedback", count: 3 }
  reward      Json // { points: 100, xp: 50 }
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  users UserQuest[]

  @@index([type])
  @@index([isActive])
}

model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  questId     String
  progress    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
  @@index([questId])
}

model Reward {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  cost        Int // Points required
  type        String   @default("digital") // digital, physical, coupon
  stock       Int      @default(-1) // -1 = unlimited
  metadata    Json? // Additional reward data
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserReward[]

  @@index([type])
  @@index([isActive])
}

model UserReward {
  id         String    @id @default(cuid())
  userId     String
  rewardId   String
  redeemedAt DateTime  @default(now())
  claimedAt  DateTime?
  code       String?   @unique // For coupon codes

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([rewardId])
}

// ─────────────────────────────────────────────────────────────
// QR CODE & FEEDBACK MODELS
// ─────────────────────────────────────────────────────────────

model QRCode {
  id            String    @id @default(cuid())
  code          String    @unique
  name          String
  description   String?
  dealerId      String
  isActive      Boolean   @default(true)
  scanCount     Int       @default(0)
  expiresAt     DateTime? // lifecycle: optional expiry; null = no expiry
  revokedAt     DateTime? // lifecycle: revoked (e.g. lost); null = not revoked
  segmentConfig Json? // madde 45: { "new": { "welcomeText": "..." }, "returning": { "welcomeText": "..." } }
  locationId    String? // bağlı olduğu mekan/şube (null = işletme geneli)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  dealer    User       @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  location  DealerLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  feedbacks Feedback[]
  tablePulses TablePulse[]

  @@index([code])
  @@index([dealerId])
  @@index([isActive])
  @@index([expiresAt])
  @@index([locationId])
}

/// Bayinin fiziksel mekanı/şubesi. Telefon teklifleri ve QR kodlar mekana özel
/// olabilsin diye eklendi. Bir bayinin birden çok mekanı olabilir.
model DealerLocation {
  id        String   @id @default(cuid())
  dealerId  String
  name      String // "Merkez", "Şube 2", "Kadıköy" vb.
  address   String?
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealer          User             @relation("DealerLocations", fields: [dealerId], references: [id], onDelete: Cascade)
  qrCodes         QRCode[]
  remedyTemplates RemedyTemplate[]

  @@unique([dealerId, name])
  @@index([dealerId])
}

model Feedback {
  id            String  @id @default(cuid())
  qrCodeId      String
  userId        String? // Can be anonymous
  dealerStaffId String? // Rating a specific staff member
  rating        Int // 1-5
  text          String? @db.Text
  media         Json? // Array of media URLs
  npsScore      Int? // 0-10 Net Promoter Score (Ö6)

  // -- AI Analysis: Core Sentiment --
  sentiment  String? // positive, negative, neutral
  emotions   Json? // [{ label: "happy", score: 0.8 }, ...]
  topics     Json? // ["service", "quality", ...]
  isToxic    Boolean @default(false)
  aiAnalysis Json? // Full AI response (legacy compat)

  // -- AI Analysis: Experience Signals --
  intent      String? // complaint, suggestion, praise, question, general
  intentScore Float? // 0-1 confidence score
  urgency     Float? // 0-1 urgency score
  effortScore Float? // 0-1 customer effort
  churnRisk   Float? // 0-1 churn probability

  // -- AI Analysis: Advanced NLP --
  entities            Json? // [{ type: "product"|"person"|"location", name: "...", sentiment: "positive" }]
  themes              Json? // [{ theme: "Hizmet Kalitesi", subTheme: "Personel", sentiment: "positive", score: 0.9 }]
  statementSentiments Json? // [{ statement: "Yemekler harika", sentiment: "positive", score: 0.95 }]
  actionSuggestions   Json? // [{ action: "Garson egitimi verin", priority: "high", impact: "..." }]

  // -- AI Learning Relations --
  aiEmbedding   AIEmbedding?
  aiCorrections AIFeedbackCorrection[]

  // -- AI Processing Meta --
  aiProcessedAt DateTime? // AI analiz zamani
  aiModelUsed   String? // groq/openai + model adi
  aiVersion     String? // AI analiz prompt versiyonu

  // -- Karakter Rozeti: yorumun ÜSLUP kategorisi (dram-suc|komedi|fantastik|gizem-gerilim) --
  // Her yorum yazıldığında AI belirler; kullanıcıya GÖSTERİLMEZ. Aynı kategoride
  // eşik (6) yorum birikince o kategorinin karakter rozeti açılır. Bkz. lib/character-categories.
  characterCategory String?

  // -- Dealer Reply --
  dealerReply          String?   @db.Text
  dealerRepliedAt      DateTime?
  /// Bayi geri bildirimi ilk kez açtığında (şeffaf yolculuk için)
  dealerFirstViewedAt DateTime?

  // -- Scan attribution (ROI / campaign) --
  utmSource         String? // utm_source
  utmCampaign       String? // utm_campaign
  utmMedium         String? // utm_medium
  attributionSource String? // branch, app, web

  fraudScore Float? // 0-1 sahte yorum / anomali skoru (madde 41)

  // Trust Score: gönderen kullanıcının güven sinyalleri düşükse işaretlenir.
  // "Sadece işaretle" politikası: yorum silinmez/gizlenmez, bayi/admin görür.
  trustFlagged Boolean @default(false)
  trustReason  String? // işaretleme sebebi (sıklık, tekrar, düşük güven vb.)

  isPublic  Boolean   @default(true)
  deletedAt DateTime? // soft delete; null = active
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  qrCode           QRCode            @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  staff            DealerStaff?      @relation(fields: [dealerStaffId], references: [id], onDelete: SetNull)
  actionItems      ActionItem[]
  remedyOffers     RemedyOffer[]
  aiQualitySamples AIQualitySample[]

  @@index([qrCodeId])
  @@index([userId])
  @@index([rating])
  @@index([sentiment])
  @@index([intent])
  @@index([createdAt])
  @@index([aiProcessedAt])
  @@index([deletedAt])
  @@index([dealerStaffId])
  // Dealer feedback inbox: where qrCode{dealerId} → qrCodeId IN(...) + deletedAt:null + orderBy createdAt
  @@index([qrCodeId, deletedAt, createdAt])
  // Müşteri geçmişi: where userId + createdAt range / orderBy
  @@index([userId, createdAt])
  // Karakter rozeti kategori sayımı: where userId + characterCategory (deletedAt null).
  @@index([userId, characterCategory])
}

// ─────────────────────────────────────────────────────────────
// SYSTEM MODELS
// ─────────────────────────────────────────────────────────────

// P1: Install-to-value - işletme kayıttan ilk anlamlı insight'a süre
model DealerOnboardingEvent {
  id        String   @id @default(cuid())
  dealerId  String
  eventType String // registered, firstQR, firstFeedback, firstInsight
  createdAt DateTime @default(now())

  dealer User @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@index([eventType])
  @@index([createdAt])
}

// P2-22: Pre-aggregated daily dealer stats for fast dashboard
model DailyDealerStats {
  id                     String   @id @default(cuid())
  dealerId               String
  date                   DateTime @db.Date
  feedbackCount          Int      @default(0)
  avgRating              Float    @default(0)
  consumptionCount       Int      @default(0)
  consumptionReviewCount Int      @default(0)
  scanCount              Int      @default(0)
  positiveCount          Int      @default(0)
  neutralCount           Int      @default(0)
  negativeCount          Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  dealer User @relation(fields: [dealerId], references: [id], onDelete: Cascade)

  @@unique([dealerId, date])
  @@index([dealerId])
  @@index([date])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  category  String   @default("general")
  updatedAt DateTime @updatedAt

  @@index([category])
}

/// Stajyer görev maili gönderim + AÇILMA takibi. Gönderimde bir kayıt oluşur; alıcı maili
/// açınca (tracking pixel) firstOpenedAt + openCount güncellenir. Admin panelinde "açıldı mı"
/// göstergesi bunu okur. token = pixel URL'sindeki opak kimlik (tahmin edilemez).
model InternEmailSend {
  id            String    @id @default(cuid())
  token         String    @unique // pixel URL kimliği (nanoid)
  templateId    String    // hangi görev şablonu
  department    String
  recipientName String
  email         String
  subject       String
  kind          String    @default("send") // send | test
  status        String    @default("sent")  // sent | error (gönderim başarısı)
  lastError     String?   // gönderim hatası mesajı (status=error ise)
  sentByUserId  String?   // gönderen admin
  channel       String?   // smtp | resend
  firstOpenedAt DateTime? // ilk açılma (null = henüz açılmadı)
  lastOpenedAt  DateTime?
  openCount     Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([templateId])
  @@index([email])
  @@index([createdAt])
}

/// GELEN KUTUSU — IMAP ile qratex.co@gmail.com'dan çekilen mailler. Admin panelinde okunur.
/// fromEmail bir stajyer/görev alıcısına eşleşirse matchedTemplateId + matchedRecipientName dolar
/// (stajyerden gelen cevaplar otomatik ayrılır). uid+mailbox IMAP'te benzersiz (idempotent sync).
model InboxMessage {
  id           String    @id @default(cuid())
  uid          Int       // IMAP UID (mailbox içinde benzersiz)
  mailbox      String    @default("INBOX")
  messageId    String?   // RFC Message-ID (varsa)
  fromEmail    String    // gönderen adresi (küçük harf)
  fromName     String?
  toEmail      String?   // alıcı (genelde qratex.co@gmail.com)
  subject      String    @default("")
  snippet      String    @default("") // gövdenin ilk ~200 karakteri (liste önizleme)
  bodyText     String?   @db.Text
  bodyHtml     String?   @db.Text
  sentAt       DateTime  // mailin kendi tarihi
  seen         Boolean   @default(false) // panelde okundu işareti
  // Görev/stajyer eşleştirme (otomatik ayırma):
  isFromIntern Boolean   @default(false) // fromEmail bir görev alıcısına eşleşti mi
  matchedTemplateId   String?           // eşleşen şablon id
  matchedRecipientName String?          // eşleşen kişi adı
  matchedDepartment    String?          // eşleşen departman
  attachments  Json?     // [{ filename, contentType, size, url }] — R2'ye yüklenen ekler (metadata)
  createdAt    DateTime  @default(now()) // DB'ye çekilme zamanı

  @@unique([mailbox, uid])
  @@index([fromEmail])
  @@index([isFromIntern])
  @@index([sentAt])
}

model FeatureFlag {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  isEnabled   Boolean   @default(false)
  expiresAt   DateTime?
  ownerId     String?
  metadata    Json?
  updatedAt   DateTime  @updatedAt

  @@index([key])
  @@index([isEnabled])
  @@index([expiresAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String    @default("info") // info, success, warning, error
  isRead    Boolean   @default(false)
  data      Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  // Okunmamış rozet sayımı (sık polling) + listeleme
  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model FileUpload {
  id        String   @id @default(cuid())
  userId    String
  filename  String
  mimetype  String
  size      Int
  url       String
  thumbnail String?
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  category  String
  data      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([event])
  @@index([category])
  @@index([createdAt])
  // Hot paths: points-velocity / leaderboard anti-cheat ve feedback cap
  // sorguları userId+event+createdAt ile filtreliyor; tek sütun index yetmiyordu.
  @@index([userId, event, createdAt])
  @@index([userId, category, event, createdAt])
}

/// Günlük çark çevirme sayacı. (userId, day) UNIQUE → atomik upsert ile
/// eşzamanlı çift-spin engellenir (önceden Notification sayımına bağlıydı, racy).
model DailySpin {
  id        String   @id @default(cuid())
  userId    String
  day       DateTime @db.Date // UTC gün (00:00)
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
}

/// Mini oyun günlük seri (streak) bonusunun günde tek kez verilmesini ATOMİK
/// garanti eder. (userId, dayKey) UNIQUE → aynı gün iki farklı oyunun eşzamanlı
/// tamamlanmasında yalnızca biri bu kaydı oluşturabilir, diğeri P2002 alır ve
/// bonus verilmez (önceden count-then-act idi → Read Committed'da çift bonus).
model GameStreakClaim {
  id        String   @id @default(cuid())
  userId    String
  dayKey    String // "YYYY-MM-DD" (UTC)
  createdAt DateTime @default(now())

  @@unique([userId, dayKey])
  @@index([userId])
}

/// Haftalık mini-oyun turnuvası ödül talebi. Bir kullanıcı, bir oyunun bir haftalık
/// turnuvasından ödülü YALNIZCA BİR KEZ alabilir (atomik tek-claim, GameStreakClaim
/// deseni). Ödül, hafta KAPANDIKTAN sonra sıralamaya göre verilir.
model TournamentRewardClaim {
  id        String   @id @default(cuid())
  userId    String
  gameType  String
  weekKey   String // "YYYY-Www" ISO hafta (UTC), örn "2026-W32" — KAPANMIŞ hafta
  rank      Int // ödül anındaki sıra (1..3)
  points    Int // verilen puan
  createdAt DateTime @default(now())

  @@unique([userId, gameType, weekKey])
  @@index([userId])
  @@index([gameType, weekKey])
}

/// DB-backed rate limiter / login lockout. Serverless'te her Lambda kendi
/// belleğinde olduğu ve cold start sayaçları sıfırladığı için in-memory Map
/// güvenilir değildi; brute-force/flood koruması bu tabloya taşındı.
model RateLimitCounter {
  bucket    String   @id // örn "login:1.2.3.4:user@x", "scan:ip", "lockout:..."
  count     Int      @default(0)
  resetAt   DateTime
  lockedUntil DateTime?
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  // Quest ödül dedupe: where userId + action + entity + entityId IN(...)
  @@index([userId, action, entity])
}

model UserAutomationRule {
  id               String   @id @default(cuid())
  name             String
  description      String?  @db.Text
  triggerType      String   @default("manual") // manual, schedule, event
  triggerConfig    Json?
  condition        Json // { role, minPoints, ... }
  actions          Json // [{ type, ... }]
  isActive         Boolean  @default(true)
  priority         Int      @default(100)
  requiresApproval Boolean  @default(false)
  createdById      String
  updatedById      String?
  approvedById     String?
  approvedAt       DateTime?
  lastRunAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  createdBy User  @relation("AutomationRulesCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  updatedBy User? @relation("AutomationRulesUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  approvedBy User? @relation("AutomationRulesApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)

  runs UserAutomationRun[]
  jobs AutomationJob[]

  @@index([isActive])
  @@index([priority])
  @@index([triggerType])
  @@index([createdById])
}

model UserAutomationRun {
  id             String    @id @default(cuid())
  ruleId         String?
  status         String    @default("pending") // pending, running, completed, failed, cancelled
  mode           String    @default("execute") // execute, dry_run
  triggeredById  String?
  idempotencyKey String?
  source         String? // ui, api, scheduler
  summary        Json?
  affectedCount  Int       @default(0)
  successCount   Int       @default(0)
  failedCount    Int       @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  error          String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rule        UserAutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  triggeredBy User?               @relation("AutomationRunsTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)
  jobs        AutomationJob[]

  @@index([ruleId])
  @@index([status])
  @@index([mode])
  @@index([createdAt])
  @@index([idempotencyKey])
}

model AutomationJob {
  id             String    @id @default(cuid())
  ruleId         String?
  runId          String?
  status         String    @default("queued") // queued, processing, completed, failed, cancelled
  payload        Json?
  idempotencyKey String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3)
  nextRunAt      DateTime  @default(now())
  lockedAt       DateTime?
  lockedBy       String?
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  rule UserAutomationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  run  UserAutomationRun?  @relation(fields: [runId], references: [id], onDelete: SetNull)

  @@index([status, nextRunAt])
  @@index([ruleId])
  @@index([runId])
  @@index([idempotencyKey])
}

// Bölüm 11: Dış sistemlere olay bildirimi (Admin’de yapılandırma)
model Webhook {
  id          String   @id @default(cuid())
  url         String   @db.Text
  secret      String?  @db.Text // HMAC imza için opsiyonel
  events      Json // ["feedback.created", "badge.earned", ...]
  isActive    Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([createdById])
}

// Bölüm 11: Harici entegrasyon için API anahtarları (Admin’de oluşturma/yönetim)
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String // SHA-256 hash; ham anahtar sadece oluşturulurken gösterilir
  keyPrefix   String // İlk 8 karakter (gösterim için)
  scope       Json? // ["read:feedbacks", "write:cards"] vb.
  lastUsedAt  DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([keyPrefix])
  @@index([createdById])
}

// Incident/Kriz radarı (madde 35): eşik aşımında alarm + görev
model Incident {
  id             String    @id @default(cuid())
  dealerId       String
  type           String // rating_drop, nps_drop, negative_spike, custom
  severity       String // low, medium, high, critical
  status         String    @default("open") // open, assigned, in_progress, resolved
  title          String
  description    String?   @db.Text
  thresholdValue Float? // eşik değeri (örn. ortalama rating)
  assignedToId   String?
  dueAt          DateTime?
  resolvedAt     DateTime?
  metadata       Json? // ek bağlam
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  dealer     User  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("IncidentAssignments", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([dealerId])
  @@index([status])
  @@index([createdAt])
  // Açık incident kontrolü: where dealerId + status
  @@index([dealerId, status])
}

// P2 Churn playbook: CSM görevi - düşük tenant health için CSM takibi
model CSMTask {
  id               String    @id @default(cuid())
  dealerId         String
  type             String    @default("churn_risk") // churn_risk, at_risk, etc.
  status           String    @default("open") // open, in_progress, resolved
  priority         String    @default("medium") // low, medium, high
  healthScore      Float? // Tenant health at creation
  suggestedActions Json? // [{ action: string, priority: string }]
  telafiDraft      String?   @db.Text // Telafi önerisi taslak metni
  assignedToId     String?
  dueAt            DateTime?
  resolvedAt       DateTime?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  dealer     User  @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  assignedTo User? @relation("CSMTaskAssignments", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([dealerId])
  @@index([status])
  @@index([createdAt])
}

// AI Action Engine (madde 36): öneri -> sahip atama -> takip
// feedbackId null ise sistem/AI aggregate önerisi (sidebar verilerinden üretilmiş)
model ActionItem {
  id             String    @id @default(cuid())
  feedbackId     String? // null = AI aggregate (sidebar verilerinden)
  dealerId       String
  suggestionText String    @db.Text // AI önerisi metni
  priority       String    @default("medium") // low, medium, high
  status         String    @default("pending") // pending, assigned, in_progress, done, cancelled
  assignedToId   String?
  dueAt          DateTime?
  completedAt    DateTime?
  sourceModule   String? // ai_aggregate, feedback, incident, agent_council
  impactScore    Float? // 0–100 tahmini etki
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  feedback   Feedback? @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  dealer     User      @relation(fields: [dealerId], references: [id], onDelete: Cascade)
  assignedTo User?     @relation("ActionItemAssignments", fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([feedbackId])
  @@index([dealerId])
  @@index([status])
}

// Telafi teklifi: dealer gönderir, müşteri tür/miktar seçip kabul eder. QR feedback veya tüketim yorumundan tetiklenebilir.
model RemedyOffer {
  id                  String    @id @default(cuid())
  feedbackId          String? // QR feedback (null ise consumptionReviewId dolu)
  consumptionReviewId String? // tüketim yorumu (null ise feedbackId dolu)
  dealerId            String
  userId              String // müşteri
  message             String    @db.Text
  /// pending=müşteriye açık; awaiting_dealer_approval=onay kuyruğu; accepted, expired, rejected
  status              String    @default("pending")
  options             Json? // [{ type, label, unit, values: [] }] müşterinin seçebileceği tür ve miktarlar
  selectedType        String? // müşterinin seçtiği: discount, points, free_item
  selectedValue       String? // müşterinin seçtiği değer: "20", "100", "1"
  createdAt           DateTime  @default(now())
  acceptedAt          DateTime?

  feedback          Feedback?          @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  consumptionReview ConsumptionReview? @relation(fields: [consumptionReviewId], references: [id], onDelete: Cascade)
  dealer            User               @relation("DealerRemedyOffers", fields: [dealerId], references: [id], onDelete: Cascade)
  user              User               @relation("CustomerRemedyOffers", fields: [userId], references: [id], onDelete: Cascade)
  timelineEvents    RemedyTimelineEvent[]

  @@index([feedbackId])
  @@index([consumptionReviewId])
  @@index([dealerId])
  @@index([userId])
  @@index([status])
  // Dealer onay kuyruğu: where dealerId + status
  @@index([dealerId, status])
}

/// Bayinin telafi teklif şablonu. Hardcoded DEFAULT_OPTIONS'ın yerini alır:
/// bayi kendi indirim/puan/ücretsiz-ürün seçeneklerini ve değerlerini tanımlar.
/// locationId null ise işletme geneli; dolu ise yalnızca o mekana özel.
model RemedyTemplate {
  id         String   @id @default(cuid())
  dealerId   String
  locationId String? // null = işletme geneli; dolu = mekana özel
  type       String // discount | points | free_item
  label      String // "İndirim", "Puan", "Ücretsiz ürün/içecek"
  unit       String // "%", "puan", "adet"
  values     Json // izin verilen değerler: [10, 15, 20]
  isActive   Boolean  @default(true)
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  dealer   User            @relation("DealerRemedyTemplates", fields: [dealerId], references: [id], onDelete: Cascade)
  location DealerLocation? @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@index([locationId])
  @@index([dealerId, isActive])
}

// ─────────────────────────────────────────────────────────────
// CMS MODELS
// ─────────────────────────────────────────────────────────────

model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  content     Json // Block-based content
  meta        Json? // SEO metadata
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

model MenuItem {
  id        String   @id @default(cuid())
  location  String // header, footer, sidebar
  label     String
  href      String
  icon      String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  parentId  String?
  roles     Json? // ["ADMIN", "DEALER"] or null for all
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([location])
  @@index([isActive])
  @@index([order])
}

model Theme {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(false)
  colors    Json // Color palette
  fonts     Json? // Font settings
  customCss String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model PricingPlan {
  id             String   @id @default(cuid())
  name           String
  description    String?
  price          Float
  currency       String   @default("TRY")
  interval       String   @default("monthly") // monthly, yearly, lifetime
  features       Json // Array of feature strings
  maxQRCodes     Int? // null = unlimited (P3 segment fiyatlandırma)
  maxBranches    Int? // null = unlimited
  pricePerBranch Float? // Şube başına ek ücret (opsiyonel)
  stripePriceId  String? // Stripe Price ID (Checkout için); null = Stripe'sız plan
  isPopular      Boolean  @default(false)
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dealers User[] @relation("DealerPricingPlan")

  @@index([isActive])
  @@index([order])
}

// P3 Partner kanalı: entegrasyon partnerleri
model Partner {
  id         String   @id @default(cuid())
  name       String
  type       String // POS, ajans, dijital_menu
  apiKeyHash String? // API anahtarı hash (saklanır)
  webhookUrl String? // Event webhook URL
  metadata   Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

model Coupon {
  id          String    @id @default(cuid())
  code        String    @unique
  type        String    @default("percentage") // percentage, fixed
  value       Float
  minPurchase Float?
  maxUses     Int       @default(-1) // -1 = unlimited
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([code])
  @@index([isActive])
}

/// Kupon kullanımı: kullanıcı başına tek kullanım garantisi. (userId, couponId)
/// UNIQUE → eşzamanlı çift-kullanım transaction içinde DB seviyesinde reddedilir
/// (AnalyticsEvent okuması racy idi; DailySpin/UserCosmetic ile aynı atomik desen).
model CouponRedemption {
  id        String   @id @default(cuid())
  userId    String
  couponId  String
  createdAt DateTime @default(now())

  @@unique([userId, couponId])
  @@index([couponId])
}

// ─────────────────────────────────────────────────────────────
// PHYSICAL CARD SYSTEM (QR Kartlı Tüketim Sistemi)
// ─────────────────────────────────────────────────────────────

enum CardStatus {
  UNUSED // Henüz aktive edilmemiş
  ACTIVATED // Müşteriye bağlanmış
  BLOCKED // Bloklanmış
}

model PhysicalCard {
  id          String     @id @default(cuid())
  token       String     @unique // Benzersiz QR token (nanoid)
  batchId     String? // Toplu üretim batch ID
  status      CardStatus @default(UNUSED)
  customerId  String? // Aktive edildiğinde müşteri ID
  activatedAt DateTime?
  blockedAt   DateTime?
  blockReason String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  customer     User?          @relation("CustomerCards", fields: [customerId], references: [id], onDelete: SetNull)
  consumptions Consumption[]
  auditLogs    CardAuditLog[]

  @@index([token])
  @@index([status])
  @@index([customerId])
  @@index([batchId])
  @@index([createdAt])
}

model ProductCategory {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("🍽️")
  dealerId  String? // null = global kategori
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealer   User?     @relation("DealerCategories", fields: [dealerId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([dealerId])
  @@index([isActive])
  @@index([order])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  price       Float?
  categoryId  String
  dealerId    String? // null = global ürün
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category     ProductCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  dealer       User?                   @relation("DealerProducts", fields: [dealerId], references: [id], onDelete: Cascade)
  consumptions Consumption[]
  favoritedBy  DealerFavoriteProduct[] @relation("FavoritedBy")
  quickPresets QuickScanPreset[]       @relation("QuickPresetProducts")

  @@index([categoryId])
  @@index([dealerId])
  @@index([isActive])
}

model Consumption {
  id         String   @id @default(cuid())
  cardId     String
  customerId String
  dealerId   String
  productId  String?
  amount     Float? // Tutar (opsiyonel)
  note       String? // Bayi notu
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  card     PhysicalCard       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  customer User               @relation("CustomerConsumptions", fields: [customerId], references: [id], onDelete: Cascade)
  dealer   User               @relation("DealerConsumptions", fields: [dealerId], references: [id], onDelete: Cascade)
  product  Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  review   ConsumptionReview?

  @@index([cardId])
  @@index([customerId])
  @@index([dealerId])
  @@index([productId])
  @@index([createdAt])
  // Dealer zaman aralığı taramaları (pre-agg, radar, analytics)
  @@index([dealerId, createdAt])
  // Müşteri zaman aralığı + fraud velocity (write hot-path)
  @@index([customerId, createdAt])
}

model ConsumptionReview {
  id              String    @id @default(cuid())
  consumptionId   String    @unique
  customerId      String
  rating          Int // 1-5 genel puan
  text            String?   @db.Text
  dimensions      Json? // { taste: 5, service: 4, ambiance: 5, value: 4 }
  dealerReply     String?   @db.Text
  dealerRepliedAt DateTime?
  // Karakter rozeti: yorumun ÜSLUP kategorisi (dram-suc|komedi|fantastik|gizem-gerilim).
  // AI belirler; kullanıcıya gösterilmez. Karakter barı bu alanı sayar. Bkz. character-categories.
  characterCategory String?
  // AI analiz sinyalleri (Feedback'teki gibi). Önceden yalnız ölü bir AnalyticsEvent'e
  // yazılıyordu; artık burada — CLV/churn hesabı (clv-core) tüketim yorumlarını da görsün.
  sentiment       String? // positive | neutral | negative
  churnRisk       Float? // 0-1 kayıp olasılığı (AI); null = analiz edilmedi
  analyzedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  consumption  Consumption   @relation(fields: [consumptionId], references: [id], onDelete: Cascade)
  customer     User          @relation("CustomerReviews", fields: [customerId], references: [id], onDelete: Cascade)
  remedyOffers RemedyOffer[]

  @@index([consumptionId])
  @@index([customerId])
  @@index([rating])
  @@index([createdAt])
  // Müşteri yorum geçmişi: where customerId + createdAt range / orderBy
  @@index([customerId, createdAt])
  // Karakter rozeti kategori sayımı: where customerId + characterCategory.
  @@index([customerId, characterCategory])
  // CLV churn agregasyonu: where customerId + churnRisk not null → _avg.
  @@index([customerId, churnRisk])
}

model CardAuditLog {
  id        String   @id @default(cuid())
  cardId    String
  userId    String?
  action    String // CREATED, ACTIVATED, BLOCKED, UNBLOCKED, SCANNED, CONSUMPTION_ADDED
  metadata  Json? // Ek bilgiler
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  card PhysicalCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User?        @relation("CardAuditLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([cardId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  // Hızlı-tarama limiti: where cardId + action + createdAt range (scan write-path)
  @@index([cardId, action, createdAt])
}

model CardBatch {
  id          String   @id @default(cuid())
  name        String // Batch adı (ör: "Ocak 2024 - 1000 Kart")
  quantity    Int // Üretilen kart sayısı
  prefix      String? // Token prefix (opsiyonel)
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation("CreatedBatches", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([createdById])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// SOCIAL RESPONSIBILITY / DONATION MODELS
// ─────────────────────────────────────────────────────────────

model DonationProject {
  id          String    @id @default(cuid())
  name        String
  description String    @db.Text
  icon        String // Emoji or icon path
  category    String // water, education, environment, animals, health
  goal        Int // Target points
  current     Int       @default(0) // Current collected points
  impact      Json // { unit: "litre", perPoint: 10, label: "Temiz Su" }
  tags        Json? // ["Temel İhtiyaç", "Afrika"]
  isActive    Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  startDate   DateTime  @default(now())
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  donations Donation[]

  @@index([category])
  @@index([isActive])
  @@index([isFeatured])
}

model Donation {
  id        String   @id @default(cuid())
  userId    String
  projectId String
  points    Int // Points donated
  message   String? // Optional message
  isPublic  Boolean  @default(true) // Show in leaderboard
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project DonationProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
// REFERRAL SYSTEM
// ─────────────────────────────────────────────────────────────

model Referral {
  id           String    @id @default(cuid())
  referrerId   String // User who referred
  referredId   String    @unique // User who was referred
  referralCode String // Code used
  status       String    @default("PENDING") // PENDING, COMPLETED, EXPIRED
  pointsEarned Int       @default(0) // Points earned by referrer
  bonusGiven   Int       @default(0) // Bonus given to referred
  completedAt  DateTime? // When referral was completed (first purchase)
  expiresAt    DateTime? // Referral expiration
  createdAt    DateTime  @default(now())

  referrer User @relation("Referrals", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferredBy", fields: [referredId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referralCode])
  @@index([status])
}

model ReferralCode {
  id         String   @id @default(cuid())
  userId     String   @unique
  code       String   @unique
  usageCount Int      @default(0)
  maxUsage   Int? // null = unlimited
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation("UserReferralCode", fields: [userId], references: [id], onDelete: Cascade)

  @@index([code])
}

// ─────────────────────────────────────────────────────────────
// STREAK & LOYALTY SYSTEM
// ─────────────────────────────────────────────────────────────

model UserStreak {
  id              String    @id @default(cuid())
  userId          String    @unique
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastActivityAt  DateTime?
  totalActiveDays Int       @default(0)
  streakFreezes   Int       @default(0) // Freeze tickets
  frozenUntil     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation("UserStreak", fields: [userId], references: [id], onDelete: Cascade)
}

model VIPTier {
  id         String   @id @default(cuid())
  name       String   @unique // Bronze, Silver, Gold, Platinum
  minPoints  Int // Minimum points required
  multiplier Float    @default(1.0) // Points multiplier
  benefits   Json // Array of benefit objects
  color      String // Hex color for UI
  icon       String // Emoji or icon
  order      Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  users UserVIPStatus[]

  @@index([minPoints])
  @@index([order])
}

model UserVIPStatus {
  id             String    @id @default(cuid())
  userId         String    @unique
  tierId         String
  totalSpent     Float     @default(0)
  lifetimePoints Int       @default(0)
  tierExpiry     DateTime? // When tier expires (if applicable)
  upgradedAt     DateTime  @default(now())

  user User    @relation("UserVIP", fields: [userId], references: [id], onDelete: Cascade)
  tier VIPTier @relation(fields: [tierId], references: [id])

  @@index([tierId])
}

// ─────────────────────────────────────────────────────────────
// HAPPY HOUR & PROMOTIONS
// ─────────────────────────────────────────────────────────────

model HappyHour {
  id          String    @id @default(cuid())
  dealerId    String? // null = global
  name        String
  description String?
  multiplier  Float     @default(2.0) // Points multiplier
  startTime   String // HH:mm format
  endTime     String // HH:mm format
  daysOfWeek  Json // [0,1,2,3,4,5,6] - 0=Sunday
  isActive    Boolean   @default(true)
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dealer User? @relation("DealerHappyHours", fields: [dealerId], references: [id], onDelete: Cascade)

  @@index([dealerId])
  @@index([isActive])
}

model SeasonalCampaign {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  type        String // BIRTHDAY, ANNIVERSARY, SEASONAL, SPECIAL
  multiplier  Float    @default(1.5)
  bonusPoints Int      @default(0)
  discount    Float? // Percentage discount
  imageUrl    String?
  conditions  Json? // Eligibility conditions
  // Zaman-sınırlı CHALLENGE (opsiyonel): etkinlik penceresinde bir hedefi tamamlayan
  // kullanıcıya ÖZEL ödül. challengeType null ise kampanya yalnız çarpan/bonus verir.
  challengeType         String? // games_played | reviews_written (etkinlik penceresinde sayılır)
  challengeGoal         Int? // hedef adet (ör. 5 oyun)
  challengeRewardPoints Int? // hedef tamamlanınca verilen özel puan
  challengeRewardBadgeId String? // opsiyonel özel rozet (Badge.id)
  isActive    Boolean  @default(true)
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime @default(now())

  @@index([type])
  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
}

/// Sezonluk etkinlik challenge ödül talebi — bir kullanıcı, bir kampanyanın
/// challenge ödülünü YALNIZCA BİR KEZ alır (atomik tek-claim).
model SeasonalChallengeClaim {
  id         String   @id @default(cuid())
  userId     String
  campaignId String
  points     Int
  createdAt  DateTime @default(now())

  @@unique([userId, campaignId])
  @@index([campaignId])
}

/// Dönemsel konsept: bir tarih penceresinde tek pakette site temasını değiştirir
/// (arka plan efekti + renk paleti + banner + opsiyonel bonus çarpan). Admin
/// planlayıcıdan oluşturulur; saatlik cron aktif konsepti Settings'e yazar.
/// Çakışan konseptlerde priority (büyük = öncelikli), sonra başlangıç tarihi.
model SeasonalConcept {
  id               String   @id @default(cuid())
  name             String // "Yaz Festivali", "Yılbaşı", "Cadılar Bayramı"
  description      String?  @db.Text
  startDate        DateTime
  endDate          DateTime
  isActive         Boolean  @default(true)
  priority         Int      @default(0)

  // Görsel kaldıraçlar (null = değiştirme)
  backgroundEffect String? // background-effect-shared VALID_VARIANTS değeri
  themePresetId    String? // theme-presets THEME_COLOR_PRESETS anahtarı
  bannerText       String? // ana sayfa/panel banner metni
  bannerEmoji      String? // banner başı emoji (🎄, 🎃, ☀️)

  // Opsiyonel gamification kaldıracı
  bonusMultiplier  Float?  @default(1.0)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([isActive])
  @@index([startDate])
  @@index([endDate])
}

model UserBirthday {
  id          String    @id @default(cuid())
  userId      String    @unique
  birthDate   DateTime
  bonusGiven  Boolean   @default(false)
  lastBonusAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation("UserBirthday", fields: [userId], references: [id], onDelete: Cascade)
}

// ─────────────────────────────────────────────────────────────
// SUSPICIOUS ACTIVITY & SECURITY
// ─────────────────────────────────────────────────────────────

model SuspiciousActivity {
  id          String    @id @default(cuid())
  userId      String?
  dealerId    String?
  cardId      String?
  type        String // RAPID_SCAN, DUPLICATE_ENTRY, UNUSUAL_AMOUNT, IP_MISMATCH, etc.
  severity    String    @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  description String    @db.Text
  metadata    Json? // Additional context
  ipAddress   String?
  userAgent   String?
  isResolved  Boolean   @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime  @default(now())

