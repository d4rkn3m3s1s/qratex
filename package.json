{
  "name": "qratex",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "node scripts/ensure-edge-instrumentation.js",
    "prebuild": "npm run catalog:admin-api",
    "build": "cross-env DISABLE_SENTRY_BUILD=1 next build --webpack && node scripts/ensure-edge-instrumentation.js",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:contract": "jest __tests__/api/contract.test.ts",
    "verify:menu": "jest __tests__/menu-visibility-catalog.test.ts",
    "synthetic": "npx ts-node scripts/synthetic-monitor.ts",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma generate && prisma db seed",
    "db:studio": "prisma studio",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "audit:admin-responsive": "node scripts/admin-responsive-scan.mjs",
    "audit:customer-responsive": "node scripts/customer-responsive-scan.mjs",
    "api:ensure-dynamic": "node scripts/ensure-api-force-dynamic.mjs",
    "catalog:admin-api": "node scripts/generate-admin-api-catalog.mjs",
    "analyze": "cross-env ANALYZE=true next build --webpack"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
